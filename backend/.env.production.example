# ========================================
# PLANTILLA DE CONFIGURACIÓN PRODUCCIÓN
# ========================================
# 
# INSTRUCCIONES:
# 1. Copia este archivo a .env.production
# 2. Reemplaza TODOS los valores con configuración real
# 3. NUNCA subas .env.production a Git
# 4. Revisa CONFIGURACION_PRODUCCION.md para más detalles
#

# ========================================
# DATABASE
# ========================================
DATABASE_URL="postgresql://user:password@production-host.com:5432/documentchain_prod"

# ========================================
# JWT (Generar con: openssl rand -base64 64)
# ========================================
JWT_SECRET="GENERA_UN_SECRET_ALEATORIO_ULTRA_SEGURO_256_BITS"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_SECRET="OTRO_SECRET_DIFERENTE_ULTRA_SEGURO_256_BITS"
JWT_REFRESH_EXPIRES_IN="7d"

# ========================================
# SERVER
# ========================================
PORT=3001
NODE_ENV="production"
CORS_ORIGIN="https://tudominio.com"

# ========================================
# IPFS (Usar servicio cloud: Pinata, Infura, Web3.Storage)
# ========================================
# Opción A: Pinata
IPFS_API_URL="https://api.pinata.cloud"
IPFS_GATEWAY_URL="https://gateway.pinata.cloud/ipfs"
PINATA_API_KEY="tu_pinata_api_key"
PINATA_SECRET_KEY="tu_pinata_secret_key"

# Opción B: Infura
# IPFS_API_URL="https://ipfs.infura.io:5001"
# IPFS_GATEWAY_URL="https://ipfs.io/ipfs"
# INFURA_PROJECT_ID="tu_project_id"
# INFURA_API_SECRET="tu_api_secret"

# ========================================
# BLOCKCHAIN - POLYGON MAINNET
# ========================================
# RPC Providers (elige uno):
# - Polygon oficial: https://polygon-rpc.com
# - Alchemy: https://polygon-mainnet.g.alchemy.com/v2/TU_API_KEY
# - Infura: https://polygon-mainnet.infura.io/v3/TU_PROJECT_ID
BLOCKCHAIN_RPC_URL="https://polygon-rpc.com"

# ⚠️ CLAVE PRIVADA - MANTENER EN SECRETO ⚠️
# Generar: Ver CONFIGURACION_PRODUCCION.md paso 1
# Almacenar: AWS Secrets Manager / Azure Key Vault
BLOCKCHAIN_PRIVATE_KEY="0xTU_CLAVE_PRIVADA_AQUI_64_CARACTERES_HEXADECIMALES"

# Direcciones de contratos desplegados en Polygon
# Obtener: Después de ejecutar `npx hardhat run scripts/deploy.js --network polygon`
CONTRACT_DOCUMENT_REGISTRY="0x..."
CONTRACT_DOCUMENT_VERSIONING="0x..."
CONTRACT_DOCUMENT_SIGNING="0x..."
CONTRACT_DOCUMENT_ACCESS_CONTROL="0x..."

# ========================================
# SSL/HTTPS (Certificados reales - Let's Encrypt)
# ========================================
SSL_KEY_PATH="/etc/letsencrypt/live/tudominio.com/privkey.pem"
SSL_CERT_PATH="/etc/letsencrypt/live/tudominio.com/fullchain.pem"

# ========================================
# EMAIL (Para notificaciones)
# ========================================
# El backend envía al Postfix del compose o a un SMTP externo.
# La entrega real a Internet es más fiable si Postfix actúa como relay de SES,
# Google Workspace o proveedor equivalente.
SMTP_HOST="postfix"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@tudominio.com"
EMAIL_FROM_NAME="DocumentChain"
FRONTEND_URL="https://tudominio.com"

# Relay del contenedor Postfix hacia Internet
SMTP_RELAYHOST="[smtp.gmail.com]:587"
SMTP_RELAYHOST_USERNAME="cuenta-salida@tudominio.com"
SMTP_RELAYHOST_PASSWORD="credencial-smtp-o-app-password"
POSTFIX_SMTP_TLS_SECURITY_LEVEL="encrypt"
POSTFIX_HOSTNAME="mail.tudominio.com"
ALLOWED_SENDER_DOMAINS="tudominio.com"
MASQUERADED_DOMAINS="tudominio.com"
POSTFIX_DKIM_AUTOGENERATE="false"

# ========================================
# LOGGING
# ========================================
LOG_LEVEL="info"
LOG_FILE_PATH="/var/log/documentchain/app.log"

# ========================================
# SECURITY
# ========================================
RATE_LIMIT_WINDOW_MS="900000"  # 15 minutos
RATE_LIMIT_MAX_REQUESTS="100"

# ========================================
# MONITORING (Opcional)
# ========================================
SENTRY_DSN="https://your-sentry-dsn"
NEW_RELIC_LICENSE_KEY="your-license-key"

# ========================================
# POLYGON MUMBAI TESTNET (Alternativa para pruebas)
# ========================================
# BLOCKCHAIN_RPC_URL="https://rpc-mumbai.maticvigil.com"
# Faucet: https://faucet.polygon.technology/
