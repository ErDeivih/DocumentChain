# Database
DATABASE_URL="postgresql://documentchain:documentchain@localhost:5433/documentchain?schema=public"

# JWT (valores de desarrollo; sustituir en producción)
JWT_SECRET="documentchain-local-dev-jwt-secret-2026-main-01"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_SECRET="documentchain-local-dev-refresh-secret-2026-main-01"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV="development"

# CORS (separar múltiples origins con comas)
ALLOWED_ORIGINS="http://localhost:5173,https://localhost:5173"

# ========================================
# CONFIGURACIÓN DE IPFS
# ========================================
# IPFS_PROVIDER: "self-hosted" para usar el nodo IPFS propio.
IPFS_PROVIDER="self-hosted"

# --- Nodo IPFS propio ---
# Desarrollo local fuera de Docker: usar localhost.
# Docker Compose con perfil ipfs: usar ipfs-node.
IPFS_API_URL="http://localhost:5001"
IPFS_GATEWAY_URL="http://localhost:8080"

# Blockchain (Hardhat local)
BLOCKCHAIN_RPC_URL="http://localhost:8545"
BLOCKCHAIN_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"

# Smart Contracts (actualizar después de deployment)
CONTRACT_DOCUMENT_REGISTRY=""

# SSL/HTTPS
SSL_KEY_PATH="./ssl/private-key.pem"
SSL_CERT_PATH="./ssl/certificate.pem"

# Rate Limiting (opcional, usa defaults)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
UPLOAD_RATE_LIMIT_MAX=500
GENERAL_RATE_LIMIT_MAX=2000
PREPARE_RATE_LIMIT_MAX=100
CONFIRM_RATE_LIMIT_MAX=150

# Admin Registration Secret (para crear el primer admin)
# Usa un valor de desarrollo distinto al JWT y genera uno aleatorio en producción
# Ejemplo producción: openssl rand -base64 32
ADMIN_REGISTRATION_SECRET="documentchain-local-dev-admin-bootstrap-secret-2026-main-01"

# ========================================
# CONFIGURACIÓN DE CORREO ELECTRÓNICO
# ========================================
# Entorno dockerizado: el backend entrega al servicio Postfix del compose.
# Postfix puede hacer entrega directa o reenviar a un relay SMTP externo.
# Para entorno de servidor se recomienda relay transaccional (por ejemplo Brevo).

# Backend -> SMTP
SMTP_HOST="postfix"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

EMAIL_FROM="noreply@documentchain.local"
EMAIL_FROM_NAME="DocumentChain"
FRONTEND_URL="https://localhost:5173"

# Ejemplo de backend SMTP directo (sin Postfix):
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="tu-login-smtp-brevo"
# SMTP_PASS="tu-clave-smtp-brevo"
# EMAIL_FROM="tu-remitente-verificado@example.com"
# EMAIL_FROM_NAME="DocumentChain"

# Relay opcional para el contenedor Postfix.
# Si se deja vacío, Postfix intentará entrega directa y la reputación dependerá
# de IP fija, PTR, SPF, DKIM y DMARC.
SMTP_RELAYHOST=""
SMTP_RELAYHOST_USERNAME=""
SMTP_RELAYHOST_PASSWORD=""
POSTFIX_SMTP_TLS_SECURITY_LEVEL="may"
POSTFIX_HOSTNAME="mail.documentchain.local"
ALLOWED_SENDER_DOMAINS="documentchain.local"
MASQUERADED_DOMAINS="documentchain.local"
POSTFIX_DKIM_AUTOGENERATE="true"

# Ejemplo recomendado para servidor: Postfix local + relay Brevo
# SMTP_HOST="postfix"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# EMAIL_FROM="tu-remitente-verificado@example.com"
# EMAIL_FROM_NAME="DocumentChain"
# SMTP_RELAYHOST="[smtp-relay.brevo.com]:587"
# SMTP_RELAYHOST_USERNAME="tu-login-smtp-brevo"
# SMTP_RELAYHOST_PASSWORD="tu-clave-smtp-brevo"
# POSTFIX_SMTP_TLS_SECURITY_LEVEL="encrypt"
# ALLOWED_SENDER_DOMAINS="example.com"
# MASQUERADED_DOMAINS="example.com"

# Ejemplo de relay SMTP externo
# SMTP_RELAYHOST="[smtp-relay.brevo.com]:587"
# SMTP_RELAYHOST_USERNAME="tu-login-smtp-brevo"
# SMTP_RELAYHOST_PASSWORD="tu-clave-smtp-brevo"
# POSTFIX_SMTP_TLS_SECURITY_LEVEL="encrypt"
# EMAIL_FROM="tu-remitente-verificado@example.com"

