# Database
DATABASE_URL="postgresql://documentchain:documentchain@localhost:5433/documentchain?schema=public"

# JWT (IMPORTANTE: Cambiar en producción)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production-min-32"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV="development"

# CORS (separar múltiples origins con comas)
ALLOWED_ORIGINS="http://localhost:5173,https://localhost:5173"

# ========================================
# CONFIGURACIÓN DE IPFS
# ========================================
# IPFS_PROVIDER: "pinata" (cloud, fácil desarrollo) o "cluster" (nodos propios)
IPFS_PROVIDER="pinata"

# --- Pinata Cloud (solo si IPFS_PROVIDER="pinata") ---
# API Key + Secret o JWT (JWT tiene prioridad)
PINATA_API_KEY="replace-with-your-pinata-api-key"
PINATA_SECRET_KEY="replace-with-your-pinata-secret-key"
PINATA_JWT="replace-with-your-pinata-jwt"
PINATA_GATEWAY="gateway.pinata.cloud"

# --- IPFS Cluster (solo si IPFS_PROVIDER="cluster") ---
# Desarrollo local fuera de Docker: usar localhost.
# Docker Compose con perfil ipfs-cluster: usar ipfs-node-1 e ipfs-cluster.
IPFS_API_URL="http://localhost:5001"
IPFS_CLUSTER_API_URL="http://localhost:9094"
IPFS_GATEWAY_URL="http://localhost:8080"

# Blockchain (Hardhat local)
BLOCKCHAIN_RPC_URL="http://localhost:8545"
BLOCKCHAIN_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"

# Smart Contracts (actualizar después de deployment)
CONTRACT_DOCUMENT_REGISTRY=""
CONTRACT_DOCUMENT_VERSIONING=""
CONTRACT_DOCUMENT_SIGNING=""
CONTRACT_DOCUMENT_ACCESS_CONTROL=""

# SSL/HTTPS
SSL_KEY_PATH="./ssl/private-key.pem"
SSL_CERT_PATH="./ssl/certificate.pem"

# Rate Limiting (opcional, usa defaults)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
UPLOAD_RATE_LIMIT_MAX=500
GENERAL_RATE_LIMIT_MAX=2000
PREPARE_RATE_LIMIT_MAX=100
CONFIRM_RATE_LIMIT_MAX=150

# Admin Registration Secret (para crear el primer admin)
# Genera un secret seguro y úsalo durante el registro del primer admin
# Ejemplo: openssl rand -base64 32
ADMIN_REGISTRATION_SECRET="change-this-to-a-secure-random-string-min-32-chars"

# ========================================
# CONFIGURACIÓN DE CORREO ELECTRÓNICO
# ========================================
# Desarrollo local: el backend puede entregar a Postfix en Docker.
# La forma mas simple de probar correos reales a Internet es SMTP directo
# contra una cuenta de Gmail con verificacion en dos pasos y contrasena
# de aplicacion. Si mas adelante se quiere un remitente propio, lo correcto
# es usar un dominio y/o un proveedor SMTP transaccional.

# Backend -> SMTP
SMTP_HOST="localhost"
SMTP_PORT="1587"
SMTP_SECURE="false"
SMTP_USER=""   # Vacío si usas Postfix local sin auth
SMTP_PASS=""

EMAIL_FROM="noreply@documentchain.local"
EMAIL_FROM_NAME="DocumentChain"
FRONTEND_URL="https://localhost:5173"

# Ejemplo recomendado para pruebas reales con Gmail SMTP directo desde backend:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="tu-cuenta@gmail.com"
# SMTP_PASS="tu-contrasena-de-aplicacion"
# EMAIL_FROM="tu-cuenta@gmail.com"
# EMAIL_FROM_NAME="DocumentChain"

# Alternativa recomendada si no quieres depender de Gmail:
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="tu-login-smtp-brevo"
# SMTP_PASS="tu-clave-smtp-brevo"
# EMAIL_FROM="tu-remitente-verificado@example.com"
# EMAIL_FROM_NAME="DocumentChain"

# Relay opcional para el contenedor Postfix.
# Si se deja vacío, Postfix intentará entrega directa y la reputación dependerá
# de IP fija, PTR, SPF, DKIM y DMARC.
SMTP_RELAYHOST=""
SMTP_RELAYHOST_USERNAME=""
SMTP_RELAYHOST_PASSWORD=""
POSTFIX_SMTP_TLS_SECURITY_LEVEL="may"
POSTFIX_HOSTNAME="mail.documentchain.local"
ALLOWED_SENDER_DOMAINS="documentchain.local"
MASQUERADED_DOMAINS="documentchain.local"
POSTFIX_DKIM_AUTOGENERATE="true"

# Ejemplo recomendado si quieres mantener Postfix local pero salir a Internet con Gmail:
# SMTP_HOST="localhost"
# SMTP_PORT="1587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# EMAIL_FROM="tu-cuenta@gmail.com"
# EMAIL_FROM_NAME="DocumentChain"
# SMTP_RELAYHOST="[smtp.gmail.com]:587"
# SMTP_RELAYHOST_USERNAME="tu-cuenta@gmail.com"
# SMTP_RELAYHOST_PASSWORD="tu-contrasena-de-aplicacion"
# POSTFIX_SMTP_TLS_SECURITY_LEVEL="encrypt"
# ALLOWED_SENDER_DOMAINS="gmail.com"
# MASQUERADED_DOMAINS="gmail.com"

# Ejemplo de relay SMTP externo
# SMTP_RELAYHOST="[smtp.gmail.com]:587"
# SMTP_RELAYHOST_USERNAME="tu-cuenta@gmail.com"
# SMTP_RELAYHOST_PASSWORD="app-password-o-credencial-smtp"
# POSTFIX_SMTP_TLS_SECURITY_LEVEL="encrypt"
# EMAIL_FROM="tu-cuenta@gmail.com"

