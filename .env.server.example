# Copy this file to a server-local path such as /opt/documentchain/.env.server
# and adjust the values for the Ubuntu machine that will run the self-hosted deployment.

# Public URLs exposed by the server
FRONTEND_URL=http://192.168.1.50:5173
ALLOWED_ORIGINS=http://192.168.1.50:5173,https://192.168.1.50:5173

# Visible sender used by account verification and password recovery.
# Use a real domain/address that your SMTP relay or MTA is authorized to send.
EMAIL_FROM=notificaciones@example.com
EMAIL_FROM_NAME=DocumentChain

# Optional direct backend SMTP override.
# Leave SMTP_HOST=postfix to keep the current architecture (backend -> local Postfix).
SMTP_HOST=postfix
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Required backend secrets for the production container
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
ADMIN_REGISTRATION_SECRET=replace-with-a-random-bootstrap-secret-of-at-least-32-characters

# Blockchain and IPFS runtime
BLOCKCHAIN_RPC_URL=http://localhost:8545
CONTRACT_DOCUMENT_REGISTRY=0x5FbDB2315678afecb367f032d93F642f64180aa3
IPFS_PROVIDER=self-hosted
IPFS_API_URL=http://ipfs-node:5001
IPFS_GATEWAY_URL=http://ipfs-node:8080
IPFS_DATA_ROOT=/opt/documentchain/ipfs

# Frontend build-time overrides
VITE_API_URL=/api
VITE_BLOCKCHAIN_RPC_URL=http://192.168.1.50:8545

# Optional Postfix relay settings consumed by docker-compose.yml
# If you use a verified sender domain, keep these domains aligned with EMAIL_FROM.
SMTP_RELAYHOST=
SMTP_RELAYHOST_USERNAME=
SMTP_RELAYHOST_PASSWORD=
POSTFIX_SMTP_TLS_SECURITY_LEVEL=may
POSTFIX_HOSTNAME=mail.example.com
ALLOWED_SENDER_DOMAINS=example.com
MASQUERADED_DOMAINS=example.com

# Optional deployment toggles consumed by scripts/deploy-ubuntu-server.sh
ENABLE_IPFS_NODE=1
RESET_DOCKER_STATE=0
AUTO_RUN_MIGRATIONS=1
AUTO_RESEED_QA=0
SEED_PROFILE=qa-fast
REQUIRE_SMTP_RELAY=0