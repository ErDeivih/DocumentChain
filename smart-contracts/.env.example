# ========================================
# SMART CONTRACTS - CONFIGURACIÓN DE DESPLIEGUE
# ========================================
# 
# INSTRUCCIONES:
# 1. Copia este archivo a .env
# 2. Completa los valores según la red donde despliegues
# 3. NUNCA subas el archivo .env a Git
#

# ========================================
# WALLET PRIVADA (Para desplegar contratos)
# ========================================
# ⚠️ MANTENER EN SECRETO - Fondea esta wallet antes de desplegar
PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"

# ========================================
# RPC URLs (Providers)
# ========================================

# Ethereum Sepolia Testnet
SEPOLIA_RPC_URL="https://sepolia.infura.io/v3/TU_INFURA_PROJECT_ID"

# Polygon Mumbai Testnet (Gratis)
POLYGON_MUMBAI_RPC_URL="https://rpc-mumbai.maticvigil.com"
# Alternativas:
# - https://polygon-mumbai.g.alchemy.com/v2/TU_ALCHEMY_KEY
# - https://polygon-mumbai.infura.io/v3/TU_INFURA_PROJECT_ID

# Polygon Mainnet (Producción)
POLYGON_RPC_URL="https://polygon-rpc.com"
# Alternativas recomendadas (más confiables):
# - https://polygon-mainnet.g.alchemy.com/v2/TU_ALCHEMY_KEY
# - https://polygon-mainnet.infura.io/v3/TU_INFURA_PROJECT_ID

# ========================================
# API KEYS (Para verificar contratos en exploradores)
# ========================================

# Etherscan (Para Ethereum/Sepolia)
# Obtener en: https://etherscan.io/myapikey
ETHERSCAN_API_KEY="TU_ETHERSCAN_API_KEY"

# PolygonScan (Para Polygon/Mumbai)
# Obtener en: https://polygonscan.com/myapikey
POLYGONSCAN_API_KEY="TU_POLYGONSCAN_API_KEY"

# ========================================
# NOTAS DE USO
# ========================================
# 
# DESPLEGAR EN LOCALHOST:
#   npx hardhat run scripts/deploy.js --network localhost
#
# DESPLEGAR EN MUMBAI (Testnet):
#   1. Fondear wallet en: https://faucet.polygon.technology/
#   2. npx hardhat run scripts/deploy.js --network mumbai
#   3. Verificar: npx hardhat verify --network mumbai 0xDireccionContrato
#
# DESPLEGAR EN POLYGON (Mainnet - Producción):
#   1. Asegurar que la wallet tenga suficiente MATIC (10-20 MATIC)
#   2. npx hardhat run scripts/deploy.js --network polygon
#   3. Verificar: npx hardhat verify --network polygon 0xDireccionContrato
#
