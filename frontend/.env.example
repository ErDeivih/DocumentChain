# API Configuration
VITE_API_URL=/api
VITE_APP_NAME=DocumentChain

# WalletConnect (for multi-wallet support)
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Blockchain Configuration (Local Development)
VITE_CHAIN_ID=31337
VITE_BLOCKCHAIN_RPC_URL=http://localhost:8545
VITE_BLOCK_EXPLORER_URL=http://localhost:8545

# Smart Contract Addresses (deployed on local Hardhat network)
VITE_CONTRACT_REGISTRY=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Security Settings
VITE_MAX_GAS_PRICE_GWEI=100
VITE_TX_TIMEOUT_MS=300000
