@startuml
!include _structure-style.puml
title Diagrama de Clases de Diseno - DocumentChain (Vista Simplificada)

skinparam classAttributeIconSize 0
skinparam classFontSize 10
hide empty members

package "Controllers (Express.js)" #DDEEFF {
    class AuthController {
        +register(req, res)
        +login(req, res)
        +logout(req, res)
        +forgotPassword(req, res)
        +verifyEmail(req, res)
    }
    class UserController {
        +getProfile(req, res)
        +updateProfile(req, res)
        +changePassword(req, res)
        +enable2FA(req, res)
    }
    class WalletController {
        +getWallets(req, res)
        +addWallet(req, res)
        +removeWallet(req, res)
        +setPrimaryWallet(req, res)
    }
    class DocumentController {
        +prepareDocument(req, res)
        +confirmDocument(req, res)
        +listDocuments(req, res)
        +getDocument(req, res)
        +downloadDocument(req, res)
        +archiveDocument(req, res)
        +deleteDocument(req, res)
    }
    class VersionController {
        +prepareVersion(req, res)
        +confirmVersion(req, res)
        +listVersions(req, res)
        +setActiveVersion(req, res)
    }
    class SignatureController {
        +prepareSignature(req, res)
        +confirmSignature(req, res)
        +listSignatures(req, res)
        +verifySignature(req, res)
    }
    class ShareController {
        +shareDocument(req, res)
        +modifyPermissions(req, res)
        +revokeAccess(req, res)
    }
    class StatsController {
        +getUserStats(req, res)
        +getGlobalStats(req, res)
    }
    class AdminController {
        +listUsers(req, res)
        +assignRole(req, res)
        +suspendUser(req, res)
        +pauseSystem(req, res)
    }
    class NotificationController {
        +getNotifications(req, res)
        +markAsRead(req, res)
    }
}

package "Services (Logica de Negocio)" #DFFFDF {
    class AuthService {
        +register(data)
        +login(email, pwd)
        +generateJWT(user)
        +verify2FA(userId, code)
    }
    class UserService {
        +getProfile(userId)
        +updateProfile(userId, data)
        +changePassword(userId, pwd)
    }
    class WalletService {
        +getUserWallets(userId)
        +addWallet(userId, address)
        +removeWallet(walletId)
    }
    class DocumentService {
        +prepareDocument(file, meta, userId)
        +confirmDocument(docId, txHash)
        +listDocuments(userId, filters)
        +downloadDocument(id, userId)
        +archiveDocument(id, userId)
        +deleteDocument(id, userId)
    }
    class VersionService {
        +prepareVersion(docId, file, userId)
        +confirmVersion(versionId, txHash)
        +listVersions(docId)
        +setActiveVersion(versionId)
    }
    class SignatureService {
        +prepareSignature(docId, userId)
        +confirmSignature(txHash, docId, userId)
        +listSignatures(docId)
        +verifySignature(sigId)
    }
    class IPFSService {
        +uploadFile(buffer, name)
        +downloadFile(cid)
        +pinFile(cid)
    }
    class BlockchainAdminService {
        -contract: ethers.Contract
        +prepareDocument(hash, cid)
        +prepareSignature(docId, signer)
        +grantAdminRole(address)
    }
    class NotificationService {
        +createNotification(data)
        +getNotifications(userId)
        +broadcastSocket(event, data)
    }
    class EmailService {
        +sendEmail(to, subject, body)
        +sendVerificationEmail(email, user, token)
    }
    class StatsService {
        +getUserStats(userId)
        +getGlobalStats()
    }
    class TwoFactorService {
        +generateSecret(userId)
        +verifyToken(userId, token)
        +generateBackupCodes(userId)
    }
    class EventListenerService {
        +startListening()
        +handleDocumentCreated(event)
        +handleDocumentSigned(event)
    }
}

package "Acceso a Datos (Prisma ORM)" #FFFDE7 {
    class PrismaClient {
        +user: UserDelegate
        +document: DocumentDelegate
        +signature: SignatureDelegate
        +wallet: WalletDelegate
        +session: SessionDelegate
        +event: EventDelegate
        +notification: NotificationDelegate
        +$queryRaw()
        +$transaction()
    }
}

' Dependencias
AuthController ..> AuthService
AuthController ..> TwoFactorService
UserController ..> UserService
WalletController ..> WalletService
DocumentController ..> DocumentService
DocumentController ..> IPFSService
VersionController ..> VersionService
VersionController ..> IPFSService
SignatureController ..> SignatureService
SignatureController ..> BlockchainAdminService
ShareController ..> DocumentService
StatsController ..> StatsService
AdminController ..> BlockchainAdminService
NotificationController ..> NotificationService

AuthService ..> PrismaClient
AuthService ..> EmailService
UserService ..> PrismaClient
WalletService ..> PrismaClient
DocumentService ..> PrismaClient
DocumentService ..> IPFSService
DocumentService ..> BlockchainAdminService
DocumentService ..> NotificationService
VersionService ..> PrismaClient
VersionService ..> IPFSService
SignatureService ..> PrismaClient
SignatureService ..> BlockchainAdminService
StatsService ..> PrismaClient
NotificationService ..> PrismaClient
TwoFactorService ..> PrismaClient
EventListenerService ..> PrismaClient
EventListenerService ..> NotificationService
@enduml
