@startuml
!include _sequence-style.puml
actor Usuario as user
boundary "Vista Auditoria blockchain" as ui
control "Endpoints de auditoria (/api/audit)" as api
control "AuditService" as srv
entity "DocumentRegistry" as sc

user -> ui: Abre la auditoria blockchain del documento
ui -> api: Solicitar eventos on-chain
api -> srv: Recuperar trazas del documento
srv -> sc: Consultar eventos del contrato para el documento
sc --> srv: Registro cronologico de eventos
srv --> api: Eventos enriquecidos para presentacion
api --> ui: Auditoria cargada
ui --> user: Ve bloques, hashes y marcas temporales

@enduml

