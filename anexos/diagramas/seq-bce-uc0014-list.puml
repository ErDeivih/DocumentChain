@startuml
!include _sequence-bce-style.puml

title UC-0014: Listar Documentos (Analisis BCE)

actor Actor
boundary "Biblioteca" as BB
control "GestorDocumentos" as CD
entity "Documento" as ED

database "Base de datos" as DB
boundary "Blockchain" as BC

Actor -> BB : 1. Accede a biblioteca
BB -> CD : 2. Solicita listado de documentos
CD -> ED : 3. Consulta documentos del usuario
ED -> DB : SELECT documentos por usuario
DB --> ED : lista de documentos
ED --> CD : retorna lista

CD -> BC : 4. Enriquece con metadatos blockchain
BC --> CD : timestamps y hashes on-chain

CD --> BB : 5. Retorna lista enriquecida
BB --> Actor : 6. Renderiza lista con paginacion

@enduml

