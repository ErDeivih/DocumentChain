@startuml
!include _sequence-style.puml
actor Usuario as user
boundary "Biblioteca" as ui
control "Endpoints de documentos\n(/api/documents)" as docApi
control "Servicio de documentos" as srv
database "PostgreSQL" as db

user -> ui: Accede a su biblioteca documental
ui -> docApi: Solicitar documentos con filtros y paginacion
docApi -> srv: Recuperar documentos visibles del usuario
srv -> db: Consultar documentos y total disponible
db --> srv: Lista paginada
srv --> docApi: Documentos preparados para la vista
docApi --> ui: Biblioteca cargada
ui --> user: Visualiza documentos, estados e iconos de tipo

@enduml

