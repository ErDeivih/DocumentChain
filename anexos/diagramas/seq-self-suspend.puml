@startuml
!include _sequence-style.puml
actor Usuario as user
boundary "Ajustes / Privacidad" as ui
control "Endpoints de usuarios (/api/users)" as api
control "UserSuspensionService" as srv
database "PostgreSQL" as db
participant "Wallet del usuario (navegador o WalletConnect)" as wallet
entity "Smart Contract" as sc

user -> ui: Solicita suspender temporalmente su cuenta
ui -> api: Preparar suspension
api -> srv: Verificar wallet principal y estado actual
srv -> db: Registrar preparacion y motivo opcional
db --> srv: Suspension preparada
srv --> api: Payload blockchain
api --> ui: Preparacion lista

ui -> wallet: Solicitar firma de suspension
wallet -> sc: Registrar suspension on-chain
sc --> wallet: txHash
wallet --> ui: txHash

ui -> api: Confirmar suspension
api -> srv: Validar transaccion y bloquear cuenta
srv -> db: Marcar usuario suspendido
db --> srv: OK
srv --> api: Suspension confirmada
api --> ui: Ajustes actualizados
ui --> user: Acceso restringido hasta reactivacion
@enduml
