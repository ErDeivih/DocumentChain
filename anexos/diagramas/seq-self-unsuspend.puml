@startuml
!include _sequence-style.puml
actor Usuario as user
boundary "Ajustes / Privacidad" as ui
control "Endpoints de usuarios (/api/users)" as api
control "UserSuspensionService" as srv
database "PostgreSQL" as db
participant "Wallet del usuario (navegador o WalletConnect)" as wallet
entity "Smart Contract" as sc

user -> ui: Solicita reactivar su cuenta
ui -> api: Preparar reactivacion
api -> srv: Verificar que la suspension es reactivable
srv -> db: Obtener wallets afectadas y registrar preparacion
db --> srv: Reactivacion preparada
srv --> api: Payload blockchain
api --> ui: Preparacion lista

ui -> wallet: Solicitar firma de reactivacion
wallet -> sc: Registrar reactivacion on-chain
sc --> wallet: txHash
wallet --> ui: txHash

ui -> api: Confirmar reactivacion
api -> srv: Registrar txHash y restaurar acceso
srv -> db: Marcar cuenta activa
db --> srv: OK
srv --> api: Reactivacion confirmada
api --> ui: Ajustes actualizados
ui --> user: La cuenta vuelve a estar operativa
@enduml

