@startuml
!include _sequence-style.puml
actor Usuario as user
boundary "UploadModal.tsx" as ui
control "DocumentController (/api/documents)" as api
control "DocumentService" as srv
control "IPFSService" as ipfs
database "Base de datos" as db
participant "Wallet (EIP-6963 / WalletConnect)" as wallet
entity "DocumentRegistry" as sc
control "EventListenerService" as listener

user -> ui: Selecciona archivo, nombre, descripcion y visibilidad
alt Visibilidad publica
    ui -> ui: Muestra advertencia de acceso publico por enlace/QR
else Visibilidad privada
    ui -> ui: Mantiene proteccion cifrada por defecto
end

ui -> api: POST /api/documents/prepare (multipart/form-data)
api -> api: Validar extension, MIME, tamano y nombre
api -> srv: prepareDocument(file, metadata, userId, walletId)
srv -> db: Verificar wallet activa del usuario
db --> srv: Wallet valida
alt Documento privado
    srv -> srv: generateSymmetricKey() + cifrar contenido con AES-256-GCM
    srv -> srv: encryptSymmetricKeyWithPublicKey(ownerPublicKey)
else Documento publico
    srv -> srv: Generar publicId unico (nanoid)
end
srv -> ipfs: uploadFile(buffer, filename)
ipfs --> srv: CID
srv -> db: Crear documento + version inicial en PREPARING
db --> srv: {documentId, versionId, blockchainId, publicId?}
srv --> api: {documentId, versionId, blockchainId, messageToSign}
api --> ui: 200 OK con datos para firmar

ui -> wallet: Solicita firma de transaccion createDocument
wallet -> sc: createDocument(blockchainId, cid, metadataHash)
sc --> wallet: txHash
wallet --> ui: txHash

ui -> api: POST /api/documents/confirm {documentId, txHash, blockchainId}
api -> srv: confirmDocument(documentId, txHash, blockchainId)
srv -> sc: getTransactionReceipt(txHash)
srv -> srv: Validar contrato, status y evento DocumentCreated(docId, owner, cid)
srv -> db: Actualizar documento y version a TX_SUBMITTED
db --> srv: OK
srv --> api: {status: "TX_SUBMITTED"}
api --> ui: 200 OK confirmacion registrada

sc -> listener: Evento DocumentCreated(docId, cid, owner, timestamp)
listener -> db: Reconciliar documento y version a SYNCED, registrar evento
listener -> ui: WebSocket / notificacion de sincronizacion
ui --> user: Documento visible en biblioteca
alt Documento publico
    ui --> user: Mostrar enlace /public/:publicId y codigo QR
end

@enduml
