@startuml
!include _sequence-style.puml
actor Administrador as admin
boundary "Panel de administracion" as ui
control "Endpoints de administracion (/api/admin)" as api
control "SystemService" as srv
database "PostgreSQL" as db
control "EmailService" as email

admin -> ui: Completa el formulario del nuevo administrador
ui -> api: Solicitar alta administrativa
api -> srv: Validar datos y rol
srv -> srv: Generar claves y recovery key
srv -> db: Crear cuenta administradora
db --> srv: Usuario creado
srv -> email: Enviar bienvenida y verificacion
email --> srv: OK
srv --> api: Usuario creado y recovery key
api --> ui: Mostrar datos de alta
ui --> admin: Entrega recovery key una sola vez
@enduml
