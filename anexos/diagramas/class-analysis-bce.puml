@startuml
!include _structure-style.puml
title Analisis BCE por paquetes funcionales
top to bottom direction

package "Boundary (Interfaz de Usuario)" <<Boundary>> {
  class "CuentaUI" <<boundary>>
  class "DocumentosUI" <<boundary>>
  class "VersionesUI" <<boundary>>
  class "FirmasUI" <<boundary>>
  class "ComparticionUI" <<boundary>>
  class "AuditoriaUI" <<boundary>>
  class "AdministracionUI" <<boundary>>
}

package "Control (Gestores de Operaciones)" <<Control>> {
  class "CuentaControl" <<control>>
  class "DocumentosControl" <<control>>
  class "VersionesControl" <<control>>
  class "FirmasControl" <<control>>
  class "ComparticionControl" <<control>>
  class "AuditoriaControl" <<control>>
  class "AdministracionControl" <<control>>
}

package "Entity (Entidades de Dominio)" <<Entity>> {
  class "Usuario" <<entity>>
  class "Wallet" <<entity>>
  class "Documento" <<entity>>
  class "Version" <<entity>>
  class "Firma" <<entity>>
  class "Permiso" <<entity>>
  class "Evento" <<entity>>
  class "Notificacion" <<entity>>
  class "Carpeta" <<entity>>
}

' Relaciones Boundary -> Control
CuentaUI --> CuentaControl
DocumentosUI --> DocumentosControl
VersionesUI --> VersionesControl
FirmasUI --> FirmasControl
ComparticionUI --> ComparticionControl
AuditoriaUI --> AuditoriaControl
AdministracionUI --> AdministracionControl

' Relaciones Control -> Entity
CuentaControl --> Usuario
CuentaControl --> Wallet
CuentaControl --> Notificacion
DocumentosControl --> Documento
DocumentosControl --> Carpeta
VersionesControl --> Version
VersionesControl --> Documento
FirmasControl --> Firma
FirmasControl --> Version
ComparticionControl --> Permiso
ComparticionControl --> Documento
AuditoriaControl --> Evento
AuditoriaControl --> Notificacion
AdministracionControl --> Usuario

@enduml
