@startuml
!include _sequence-style.puml
actor Usuario as user
boundary "Biblioteca / Etiquetas" as ui
control "Endpoints de documentos\n(/api/documents/:id)" as docApi
control "DocumentService" as srv
database "PostgreSQL" as db

== Anadir o editar tags ==
user -> ui: Edita las etiquetas del documento
ui -> docApi: Guardar tags
docApi -> srv: Validar permisos y actualizar tags
srv -> db: Actualizar campo tags del documento
db --> srv: OK
srv --> docApi: Tags actualizados
docApi --> ui: Vista refrescada
ui --> user: Etiquetas sincronizadas

@enduml

