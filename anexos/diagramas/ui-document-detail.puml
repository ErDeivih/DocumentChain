@startsalt
{+
  {
    {
      ^DocumentChain^
      ─────────────
      [Biblioteca]
      [Compartidos]
      [Carpetas]
      [Estadisticas]
      ─────────────
      [Perfil]
    } |
    {
      [Nombre del documento]
      ─────────────────────────────────────────────────
      {
        Hash de contenido: | [hash]
        Identificador IPFS: | [cid]
        Fecha de subida: | [fecha y hora]
