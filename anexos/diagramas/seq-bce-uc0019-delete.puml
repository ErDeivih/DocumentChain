@startuml
!include _sequence-bce-style.puml

title UC-0019: Eliminar Documento (Analisis BCE)

actor Actor
boundary "VistaDocumento" as BF
control "GestorDocumentos" as CG
entity "Documento" as ED

database "Base de datos" as DB

Actor -> BF : 1. Solicita eliminar documento
BF -> CG : 2. Peticion de eliminacion
CG -> ED : 3. Verifica propiedad del documento
ED -> DB : consulta propietario
DB --> ED : datos propiedad
ED --> CG : propiedad verificada

CG -> CG : 4. Verifica que no tenga compartidos activos
note right : Control comprueba que el documento no tenga accesos compartidos pendientes

CG -> ED : 5. Marca documento como eliminado
ED -> DB : UPDATE estado = DELETED
DB --> ED : confirmacion
ED --> CG : documento eliminado

CG --> BF : 6. Confirmacion de eliminacion
BF --> Actor : 7. Muestra confirmacion, redirige a lista

@enduml


