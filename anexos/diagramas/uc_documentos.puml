@startuml
!include _structure-style.puml
left to right direction
title Casos de uso - Gestion de documentos

actor "Usuario" as USER
actor "IPFS" as IPFS
actor "Blockchain" as SC

rectangle "Modulo de gestion documental" {
  usecase "UC-0013: Subir Documento" as UC13
  usecase "UC-0014: Listar Documentos" as UC14
  usecase "UC-0015: Ver Detalle de Documento" as UC15
  usecase "UC-0016: Descargar Documento" as UC16
  usecase "UC-0017: Archivar Documento" as UC17
  usecase "UC-0018: Desarchivar Documento" as UC18
  usecase "UC-0019: Eliminar Documento" as UC19
  usecase "UC-0020: Transferir Documento" as UC20
  usecase "UC-0021: Buscar Documentos" as UC21
}

UC13 -[hidden]down-> UC14
UC14 -[hidden]down-> UC15
UC15 -[hidden]down-> UC16
UC16 -[hidden]down-> UC17
UC17 -[hidden]down-> UC18
UC18 -[hidden]down-> UC19
UC19 -[hidden]down-> UC20
UC20 -[hidden]down-> UC21

USER --> UC13
USER --> UC14
USER --> UC15
USER --> UC16
USER --> UC17
USER --> UC18
USER --> UC19
USER --> UC20
USER --> UC21

IPFS --> UC13
IPFS --> UC16
IPFS --> UC19
SC --> UC13
SC --> UC20

note right of UC15
  Integra como subflujo:
  edicion de metadatos
  (nombre, descripcion).
end note

note right of UC14
  Integra la organizacion documental
  mediante busqueda, filtrado
  y navegacion por carpetas.
end note
@enduml
