@startuml
!include ../_sequence-style.puml

title UC-0010: Cambiar contraseña (Análisis BCE)

actor "Usuario autenticado" as user
boundary "Página de configuración" as ui
control "Gestor de autenticación" as ctrl
entity "Cuenta de usuario" as account

user -> ui: Solicitar cambiar contraseña
ui --> user: Mostrar formulario (actual, nueva, confirmación)

user -> ui: Introducir contraseñas
ui -> ctrl: Solicitar cambio (actual, nueva)

alt Contraseña actual incorrecta
    ctrl -> account: Validar contraseña actual
    account --> ctrl: Contraseña incorrecta
    ctrl --> ui: Error
    ui --> user: Mostrar error
else Nueva contraseña inválida (poco segura)
    ctrl --> ui: Error de validación
    ui --> user: Mostrar requisitos de contraseña
else Datos válidos
    ctrl -> account: Validar contraseña actual
    account --> ctrl: Contraseña correcta
    ctrl -> account: Actualizar hash de contraseña
    account --> ctrl: Contraseña actualizada
    ctrl -> ctrl: Invalidar otras sesiones activas (opcional)
    ctrl --> ui: Contraseña cambiada
    ui --> user: Confirmación de éxito
end

@enduml
