@startuml
!include ../_sequence-style.puml

title UC-0022: Crear versión de documento (Análisis BCE)

actor "Usuario propietario" as user
boundary "Detalle / Modal nueva versión" as ui
control "Gestor de versiones" as ctrl
entity "Documento" as doc
entity "Versión" as ver
entity "Almacenamiento" as storage

user -> ui: Seleccionar "Nueva versión"
ui --> user: Mostrar formulario (archivo, comentario)

user -> ui: Subir archivo y confirmar
ui -> ctrl: Solicitar creación de versión (idDocumento, archivo, comentario)

ctrl -> doc: Verificar propiedad
doc --> ctrl: Propiedad verificada

alt Archivo inválido
    ctrl --> ui: Error
    ui --> user: Mostrar error
else Archivo válido
    ctrl -> storage: Almacenar nuevo contenido
    storage --> ctrl: Referencia de almacenamiento
    ctrl -> ver: Crear versión (número secuencial, referencia, comentario)
    ver --> ctrl: Versión creada
    ctrl -> doc: Asociar nueva versión al documento
    doc --> ctrl: Documento actualizado
    ctrl --> ui: Versión creada
    ui --> user: Mostrar nueva versión en el historial
end

@enduml
