@startuml
!include ../_structure-style.puml

title Diagrama de Actividad — Subir documento con firma blockchain

start

:Usuario selecciona archivo;
:Introduce metadatos (nombre, descripción, tags);
:Selecciona visibilidad (público / privado);

if (Visibilidad = Público?) then (sí)
    :Mostrar advertencia: contenido accesible por enlace y QR;
else (no)
    :Mantener protección cifrada;
endif

:Validar archivo (tamaño, formato);

if (Archivo válido?) then (sí)
    :Cifrar contenido (AES-256-GCM) [privado];
    :Subir a almacenamiento distribuido (IPFS);
    :Obtener CID / hash de contenido;
    :Guardar documento en BD (estado PREPARING);
    :Generar hash de metadatos;
    
    :Solicitar firma de wallet (EIP-712);
    :Usuario firma transacción en wallet;
    
    if (Firma válida?) then (sí)
        :Enviar transacción a blockchain;
        :Registrar TX_SUBMITTED;
        
        :Esperar confirmación blockchain;
        
        if (Confirmación recibida?) then (sí)
            :Actualizar estado a SYNCED;
            :Crear versión inicial (v1);
            :Emitir notificación de éxito;
            :Mostrar enlace / QR [si público];
            stop
        else (no)
            :Marcar estado ERROR;
            :Notificar error de sincronización;
            :Permitir reintento;
            stop
        endif
    else (no)
        :Cancelar operación;
        :Eliminar documento temporal;
        stop
    endif
else (no)
    :Mostrar error de validación;
    stop
endif

@enduml
