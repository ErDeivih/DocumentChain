@startuml
!include ../_sequence-style.puml
skinparam sequence {
    ParticipantPadding 20
    MessagePadding 10
}

title UC-0001: Registrar usuario (Análisis BCE)

actor "Usuario no registrado" as user
boundary "Página de registro" as ui
control "Gestor de autenticación" as ctrl
entity "Usuario" as ent
entity "Cuenta de usuario" as account

user -> ui: Solicitar registro
ui --> user: Mostrar formulario de registro

user -> ui: Completar datos (email, usuario, contraseña)
ui -> ctrl: Solicitar creación de cuenta (datos)

alt Datos inválidos
    ctrl --> ui: Error de validación
    ui --> user: Mostrar errores de validación
else Datos válidos
    ctrl -> ent: Crear nuevo usuario
    ent -> account: Generar hash de contraseña
    account --> ent: Hash generado
    ent -> account: Generar par de claves criptográficas
    account --> ent: Claves generadas
    ent --> ctrl: Usuario creado (pendiente de verificación)
    ctrl -> ctrl: Generar token de verificación
    ctrl -> ent: Crear token de verificación de email
    ent --> ctrl: Token creado
    ctrl -> ctrl: Enviar email de verificación (asíncrono)
    ctrl --> ui: Cuenta creada, verificación pendiente
    ui --> user: Mostrar mensaje de éxito (verificar email)
end

@enduml
