@startuml
!include ../_sequence-style.puml

title UC-0026: Descargar versión específica (Análisis BCE)

actor "Usuario con acceso" as user
boundary "Pestaña de versiones" as ui
control "Gestor de versiones" as ctrl
entity "Versión" as ver
entity "Almacenamiento" as storage

user -> ui: Seleccionar versión y "Descargar"
ui -> ctrl: Solicitar descarga (idDocumento, idVersión)

ctrl -> ver: Verificar existencia de versión
ver --> ctrl: Versión encontrada

ctrl -> ver: Verificar permisos
ver --> ctrl: Permisos verificados

alt Sin permiso
    ctrl --> ui: Acceso denegado
    ui --> user: Mostrar error
else Con permiso
    ctrl -> storage: Solicitar contenido (referencia de versión)
    storage --> ctrl: Contenido
    ctrl --> ui: Archivo disponible
    ui --> user: Iniciar descarga
end

@enduml
