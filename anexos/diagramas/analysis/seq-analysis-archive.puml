@startuml
!include ../_sequence-style.puml

title UC-0017: Archivar documento (Análisis BCE)

actor "Usuario propietario" as user
boundary "Biblioteca / Detalle" as ui
control "Gestor de documentos" as ctrl
entity "Documento" as doc

user -> ui: Seleccionar "Archivar documento"
ui --> user: Solicitar confirmación
user -> ui: Confirmar archivado
ui -> ctrl: Solicitar archivado (idDocumento)

ctrl -> doc: Verificar propiedad
alt No es propietario
    doc --> ctrl: Acceso denegado
    ctrl --> ui: Error de permisos
    ui --> user: Mostrar error
else Es propietario
    doc --> ctrl: Propiedad verificada
    ctrl -> doc: Marcar como archivado
    doc --> ctrl: Documento archivado
    ctrl --> ui: Confirmación de archivado
    ui --> user: Documento movido a archivados
end

@enduml
