@startuml
!include ../_sequence-style.puml

title UC-0024: Activar versión como operacional (Análisis BCE)

actor "Usuario propietario" as user
boundary "Pestaña de versiones" as ui
control "Gestor de versiones" as ctrl
entity "Documento" as doc
entity "Versión" as ver

user -> ui: Seleccionar versión y "Establecer como operacional"
ui --> user: Solicitar confirmación
user -> ui: Confirmar
ui -> ctrl: Solicitar cambio de versión operacional (idDocumento, idVersión)

ctrl -> doc: Verificar propiedad
doc --> ctrl: Propiedad verificada

ctrl -> ver: Obtener versión actual operacional
ver --> ctrl: Versión operacional actual

ctrl -> ver: Desactivar versión actual operacional
ver --> ctrl: Desactivada

ctrl -> ver: Activar versión seleccionada como operacional
ver --> ctrl: Activada

ctrl -> doc: Actualizar versión operacional del documento
doc --> ctrl: Documento actualizado

ctrl --> ui: Versión operacional cambiada
ui --> user: Confirmación + indicador actualizado

@enduml
