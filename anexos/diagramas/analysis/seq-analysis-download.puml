@startuml
!include ../_sequence-style.puml

title UC-0016: Descargar documento (Análisis BCE)

actor "Usuario autenticado" as user
boundary "Página de detalle / Biblioteca" as ui
control "Gestor de documentos" as ctrl
entity "Documento" as doc
entity "Versión" as ver
entity "Almacenamiento" as storage

user -> ui: Solicitar descarga
ui -> ctrl: Solicitar descarga (idDocumento)

ctrl -> doc: Verificar permisos de acceso
doc --> ctrl: Permisos verificados

alt Sin permiso de descarga
    ctrl --> ui: Acceso denegado
    ui --> user: Mostrar error de permisos
else Con permiso
    ctrl -> ver: Obtener versión operacional / seleccionada
    ver --> ctrl: Versión
    ctrl -> storage: Solicitar contenido (referencia)
    storage --> ctrl: Contenido del archivo
    ctrl --> ui: Archivo disponible
    ui --> user: Iniciar descarga del archivo
end

@enduml
