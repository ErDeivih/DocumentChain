@startuml
!include ../_sequence-style.puml

title UC-0035: Ver estadísticas globales (admin) (Análisis BCE)

actor "Administrador" as admin
boundary "Panel de administración" as ui
control "Gestor de estadísticas" as ctrl
entity "Cuenta de usuario" as account
entity "Documento" as doc
entity "Firma" as sig
entity "Compartido" as share
entity "Evento" as evt

admin -> ui: Solicitar estadísticas globales
ui -> ctrl: Solicitar métricas

ctrl -> account: Contar usuarios totales / activos
account --> ctrl: Datos de usuarios

ctrl -> doc: Contar documentos totales / archivados / espacio
ctrl -> sig: Contar firmas totales
ctrl -> share: Contar comparticiones totales
ctrl -> evt: Contar eventos blockchain
ctrl -> account: Calcular actividad reciente

doc --> ctrl: Métricas de documentos
sig --> ctrl: Métricas de firmas
share --> ctrl: Métricas de comparticiones
evt --> ctrl: Métricas de eventos
account --> ctrl: Métricas de actividad

ctrl --> ui: Estadísticas consolidadas
ui --> admin: Mostrar dashboard (KPIs, gráficos, tablas)

@enduml
