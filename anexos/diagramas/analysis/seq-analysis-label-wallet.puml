@startuml
!include ../_sequence-style.puml

title UC-0007: Etiquetar wallet (Análisis BCE)

actor "Usuario propietario" as user
boundary "Página de gestión de wallets" as ui
control "Gestor de wallets" as ctrl
entity "Wallet" as wallet

user -> ui: Seleccionar "Editar etiqueta"
ui -> ctrl: Solicitar datos (idWallet)
ctrl -> wallet: Verificar propiedad
wallet --> ctrl: Propiedad verificada

ui --> user: Mostrar campo de etiqueta editable

user -> ui: Introducir nueva etiqueta
ui -> ctrl: Guardar etiqueta (idWallet, nuevaEtiqueta)

ctrl -> wallet: Actualizar etiqueta
wallet --> ctrl: Etiqueta actualizada
ctrl --> ui: Confirmación
ui --> user: Etiqueta actualizada

@enduml
