@startuml
!include ../_sequence-style.puml

title UC-0002: Iniciar sesión (Análisis BCE)

actor "Usuario" as user
boundary "Página de inicio de sesión" as ui
control "Gestor de autenticación" as ctrl
entity "Cuenta de usuario" as account
entity "Sesión activa" as session

user -> ui: Introducir credenciales (email/usuario, contraseña)
ui -> ctrl: Solicitar inicio de sesión (credenciales)

alt Credenciales inválidas
    ctrl -> account: Validar credenciales
    account --> ctrl: Credenciales incorrectas
    ctrl --> ui: Error de autenticación
    ui --> user: Mostrar "credenciales inválidas"
else Correo no verificado
    ctrl -> account: Validar credenciales
    account --> ctrl: Credenciales válidas, email no verificado
    ctrl --> ui: Bloqueo por verificación pendiente
    ui --> user: Mostrar bloqueo + opción reenviar verificación
else Credenciales válidas + 2FA activo
    ctrl -> account: Validar credenciales
    account --> ctrl: Credenciales válidas, 2FA activo
    ctrl --> ui: Solicitar segundo factor (tempToken)
    ui --> user: Mostrar pantalla 2FA
    user -> ui: Introducir código 2FA
    ui -> ctrl: Validar código 2FA (tempToken, código)
    alt Código 2FA inválido
        ctrl --> ui: Código incorrecto
        ui --> user: Mostrar error
    else Código 2FA válido
        ctrl -> session: Crear sesión activa
        session --> ctrl: Sesión creada
        ctrl --> ui: Tokens + perfil de usuario
        ui --> user: Acceso concedido (redirigir)
    end
else Credenciales válidas sin 2FA
    ctrl -> account: Validar credenciales
    account --> ctrl: Credenciales válidas
    ctrl -> session: Crear sesión activa
    session --> ctrl: Sesión creada
    ctrl --> ui: Tokens + perfil de usuario
    ui --> user: Acceso concedido (redirigir)
end

@enduml
