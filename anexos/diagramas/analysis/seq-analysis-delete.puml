@startuml
!include ../_sequence-style.puml

title UC-0019: Eliminar documento (Análisis BCE)

actor "Usuario propietario" as user
boundary "Biblioteca / Detalle" as ui
control "Gestor de documentos" as ctrl
entity "Documento" as doc
entity "Versión" as ver

user -> ui: Seleccionar "Eliminar documento"
ui --> user: Mostrar confirmación (advertencia de eliminación permanente)

user -> ui: Confirmar eliminación
ui -> ctrl: Solicitar eliminación (idDocumento)

ctrl -> doc: Verificar propiedad
doc --> ctrl: Propiedad verificada

alt Documento compartido / firmado
    ctrl -> ver: Verificar firmas activas
    ver --> ctrl: Firmas existentes
    ctrl --> ui: Advertencia (documento con firmas/comparticiones)
    ui --> user: Mostrar advertencia y solicitar confirmación adicional
    user -> ui: Confirmar eliminación forzada
    ui -> ctrl: Eliminar forzosamente
end

ctrl -> doc: Eliminar documento y versiones
doc --> ctrl: Documento eliminado
ctrl --> ui: Confirmación de eliminación
ui --> user: Documento eliminado permanentemente

@enduml
