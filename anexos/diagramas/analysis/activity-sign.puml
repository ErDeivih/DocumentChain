@startuml
!include ../_structure-style.puml

title Diagrama de Actividad — Firmar documento blockchain

start

:Usuario accede al documento;
:Selecciona "Firmar documento";

:Verificar permisos de acceso;

if (Tiene permiso?) then (sí)
    :Verificar documento no archivado;
    
    if (Documento activo?) then (sí)
        :Obtener versión operacional;
        :Calcular hash del documento;
        
        :Mostrar selector de wallets;
        :Usuario selecciona wallet;
        
        :Verificar wallet pertenece al usuario;
        
        if (Wallet válida?) then (sí)
            :Generar mensaje EIP-712 (hash del documento);
            :Solicitar firma criptográfica a la wallet;
            
            :Usuario confirma en wallet externa;
            
            if (Firma recibida?) then (sí)
                :Validar firma (recuperar dirección);
                
                if (Firma válida?) then (sí)
                    :Enviar transacción a DocumentRegistry;
                    :Registrar firma on-chain;
                    
                    :Esperar confirmación blockchain;
                    
                    if (Confirmación?) then (sí)
                        :Guardar firma en BD;
                        :Actualizar estado de firmas del documento;
                        :Notificar al propietario;
                        :Mostrar certificado de firma;
                        stop
                    else (no)
                        :Marcar firma como pendiente;
                        :Reintentar sincronización;
                        stop
                    endif
                else (no)
                    :Error: firma no válida;
                    stop
                endif
            else (no)
                :Usuario canceló en wallet;
                stop
            endif
        else (no)
            :Error: wallet no válida;
            stop
        endif
    else (no)
        :Error: documento archivado;
        stop
    endif
else (no)
    :Error: sin permiso;
    stop
endif

@enduml
