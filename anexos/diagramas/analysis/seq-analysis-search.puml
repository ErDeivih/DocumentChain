@startuml
!include ../_sequence-style.puml

title UC-0021: Buscar documentos (Análisis BCE)

actor "Usuario autenticado" as user
boundary "Barra de búsqueda" as ui
control "Gestor de documentos" as ctrl
entity "Documento" as doc
entity "Carpeta" as folder

user -> ui: Introducir término de búsqueda
ui -> ctrl: Solicitar búsqueda (término, filtros)

ctrl -> doc: Buscar por nombre, descripción, tags
doc --> ctrl: Resultados de documentos
ctrl -> folder: Buscar por nombre
folder --> ctrl: Resultados de carpetas

ctrl --> ui: Resultados combinados
ui --> user: Mostrar lista de resultados (documentos + carpetas)

user -> ui: Aplicar filtro adicional (tipo, fecha, propietario)
ui -> ctrl: Refinar búsqueda
ctrl -> doc: Aplicar filtros adicionales
doc --> ctrl: Resultados refinados
ctrl --> ui: Resultados filtrados
ui --> user: Actualizar resultados

@enduml
