@startuml
!include ../_sequence-style.puml

title UC-0036: Verificar autenticidad de documento (Análisis BCE)

actor "Usuario público / Auditor" as user
boundary "Página pública de verificación" as ui
control "Gestor de verificación" as ctrl
entity "Documento" as doc
entity "Versión" as ver
entity "Firma" as sig

user -> ui: Acceder enlace / QR de verificación
ui -> ctrl: Solicitar verificación (publicId / hash)

ctrl -> doc: Buscar documento por identificador público
doc --> ctrl: Documento encontrado

ctrl -> ver: Obtener versión operacional
ver --> ctrl: Versión operacional

ctrl -> doc: Verificar hash on-chain vs hash actual
alt Documento no encontrado
    ctrl --> ui: Documento no encontrado
    ui --> user: Mostrar error
else Documento encontrado
    ctrl -> sig: Verificar firmas existentes
    sig --> ctrl: Estado de firmas

    ctrl -> ver: Comparar hash IPFS actual vs hash registrado
    ver --> ctrl: Resultado de comparación

    alt Documento modificado
        ctrl --> ui: Autenticidad comprometida
        ui --> user: Mostrar alerta (hash no coincide)
    else Documento auténtico
        ctrl --> ui: Documento verificado
        ui --> user: Mostrar certificado (propietario, hash, timestamp, firmas)
    end
end

@enduml
