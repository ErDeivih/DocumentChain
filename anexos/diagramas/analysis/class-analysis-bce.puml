package "Boundary (Interfaces de Usuario)" #E3F2FD {
    class "PaginaLogin" as BLogin <<boundary>>
    class "PaginaRegistro" as BRegister <<boundary>>
    class "PaginaPerfil" as BProfile <<boundary>>
    class "BibliotecaDocumentos" as BLibrary <<boundary>>
    class "ModalSubida" as BUpload <<boundary>>
    class "ModalCompartir" as BShare <<boundary>>
    class "ModalFirma" as BSign <<boundary>>
    class "PaginaVerificacion" as BVerify <<boundary>>
    class "PanelAdministracion" as BAdmin <<boundary>>
    class "PaginaAuditoria" as BAudit <<boundary>>
    class "CentroNotificaciones" as BNotif <<boundary>>
    class "GestorWallets" as BWallet <<boundary>>
}
package "Control (Gestores de Casos de Uso)" #E8F5E9 {
    class "GestorAutenticacion" as CAuth <<control>>
    class "GestorDocumentos" as CDoc <<control>>
    class "GestorVersiones" as CVer <<control>>
    class "GestorComparticion" as CShare <<control>>
    class "GestorFirmas" as CSign <<control>>
    class "GestorVerificacion" as CVerify <<control>>
    class "GestorAuditoria" as CAudit <<control>>
    class "GestorNotificaciones" as CNotif <<control>>
    class "GestorWallets" as CWallet <<control>>
    class "GestorAdministracion" as CAdmin <<control>>
    class "GestorEstadisticas" as CStats <<control>>
}
package "Entity (Entidades de Dominio)" #FFF3E0 {
    class "Usuario" as EUser <<entity>> {
        - id
        - username
        - email
        - passwordHash
        - fullName
        - avatarUrl
        - role
        - publicKey
        - encryptedPrivateKey
        - isEmailVerified
        - isSuspended
        - createdAt
    }
    class "Documento" as EDoc <<entity>> {
        - id
        - name
        - description
        - tags[]
        - mimeType
        - size
        - contentHash
        - metadataHash
        - isArchived
        - publicId
        - visibility
        - createdAt
    }
    class "Version" as EVer <<entity>> {
        - id
        - versionNumber
        - ipfsCid
        - comment
        - isOperational
        - createdAt
    }
    class "Firma" as ESig <<entity>> {
        - id
        - signedAt
        - blockchainTxHash
        - signatureHash
    }
    class "Compartido" as EShare <<entity>> {
        - id
        - permission
        - expiresAt
        - createdAt
    }
    class "Wallet" as EWallet <<entity>> {
        - id
        - walletAddress
        - isPrimary
        - isConnected
        - nickname
        - addedAt
    }
    class "Carpeta" as EFolder <<entity>> {
        - id
        - name
        - description
        - color
        - isShared
    }
    class "Evento" as EEvent <<entity>> {
        - id
        - eventType
        - metadata
        - transactionHash
        - blockNumber
        - createdAt
    }
    class "Notificacion" as ENotif <<entity>> {
        - id
        - type
        - title
        - message
        - isRead
        - createdAt
    }
    class "TokenVerificacion" as EToken <<entity>> {
        - token
        - type
        - expiresAt
    }
    class "Sesion" as ESession <<entity>> {
        - token
        - expiresAt
        - ipAddress
        - userAgent
    }
}
