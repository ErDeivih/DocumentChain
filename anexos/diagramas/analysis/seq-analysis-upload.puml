@startuml
!include ../_sequence-style.puml

title UC-0013: Subir documento (Análisis BCE)

actor "Usuario autenticado" as user
boundary "Biblioteca / Modal de subida" as ui
control "Gestor de documentos" as ctrl
entity "Documento" as doc
entity "Versión" as ver
entity "Almacenamiento" as storage
entity "Cuenta de usuario" as account

user -> ui: Seleccionar archivo y metadatos
ui --> user: Mostrar formulario de subida (nombre, descripción, tags, visibilidad)

user -> ui: Confirmar subida
ui -> ctrl: Solicitar alta de documento (archivo, metadatos)

alt Archivo no válido (tamaño, formato)
    ctrl --> ui: Error de validación
    ui --> user: Mostrar error
else Archivo válido
    ctrl -> storage: Almacenar contenido del archivo
    storage --> ctrl: Referencia de almacenamiento
    ctrl -> doc: Crear documento (metadatos + referencia)
    doc --> ctrl: Documento creado
    ctrl -> ver: Crear versión inicial (v1, referencia)
    ver --> ctrl: Versión creada
    ctrl -> account: Asociar documento al propietario
    account --> ctrl: Asociación realizada
    ctrl --> ui: Documento creado con éxito
    ui --> user: Mostrar confirmación + acceso al detalle
end

@enduml
