@startuml
!include ../_sequence-style.puml

title UC-0008: Ver notificaciones (Análisis BCE)

actor "Usuario autenticado" as user
boundary "Centro de notificaciones" as ui
control "Gestor de notificaciones" as ctrl
entity "Notificación" as notif

user -> ui: Abrir centro de notificaciones
ui -> ctrl: Solicitar notificaciones

ctrl -> notif: Obtener notificaciones del usuario
notif --> ctrl: Lista de notificaciones (no leídas + leídas recientes)

ctrl --> ui: Lista de notificaciones
ui --> user: Mostrar notificaciones (badge, lista, acciones)

user -> ui: Marcar como leída
ui -> ctrl: Marcar leída (idNotificación)
ctrl -> notif: Actualizar estado
notif --> ctrl: Estado actualizado
ctrl --> ui: Actualizar badge

user -> ui: Marcar todas como leídas
ui -> ctrl: Marcar todas
ctrl -> notif: Actualizar todas
notif --> ctrl: Actualizadas
ctrl --> ui: Badge limpio

@enduml
