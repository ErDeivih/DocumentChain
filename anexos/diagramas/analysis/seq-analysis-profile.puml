@startuml
!include ../_sequence-style.puml

title UC-0008: Ver perfil de usuario (Análisis BCE)

actor "Usuario autenticado" as user
boundary "Página de perfil" as ui
control "Gestor de usuarios" as ctrl
entity "Cuenta de usuario" as account
entity "Wallet" as wallet

user -> ui: Solicitar perfil
ui -> ctrl: Solicitar datos de perfil

ctrl -> account: Obtener datos del usuario
account --> ctrl: Datos personales (nombre, email, avatar, estadísticas)

ctrl -> wallet: Obtener wallets asociadas
wallet --> ctrl: Lista de wallets

ctrl --> ui: Perfil completo
ui --> user: Mostrar página de perfil (datos, wallets, estadísticas)

@enduml
