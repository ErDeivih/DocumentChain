@startuml
!include _structure-style.puml
left to right direction
title Casos de uso - Acceso y cuenta

actor "Usuario" as USER
actor "Sistema de email" as EMAIL
actor "Blockchain" as SC

rectangle "Modulo de acceso y cuenta" {
  usecase "UC-0001: Registrar Usuario" as UC1
  usecase "UC-0002: Iniciar Sesion" as UC2
  usecase "UC-0003: Cerrar Sesion" as UC3
  usecase "UC-0004: Conectar Wallet" as UC4
  usecase "UC-0005: Eliminar Wallet" as UC5
  usecase "UC-0006: Establecer Wallet Principal" as UC6
  usecase "UC-0007: Renombrar Wallet" as UC7
  usecase "UC-0008: Gestionar Perfil y Notificaciones" as UC8
  usecase "UC-0009: Eliminar Cuenta" as UC9
  usecase "UC-0010: Cambiar Contrasena" as UC10
  usecase "UC-0011: Verificar Email" as UC11
  usecase "UC-0012: Reenviar Verificacion" as UC12
}

UC1 -[hidden]down-> UC2
