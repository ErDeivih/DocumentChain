@startuml
!include _sequence-style.puml
actor Admin as admin
boundary "Panel de administracion" as ui
control "Endpoints de administracion (/api/admin)" as api
control "AdminService" as srv
database "PostgreSQL" as db

admin -> ui: Selecciona usuario y motivo de suspension
ui -> api: Solicitar suspension
api -> srv: Validar operacion administrativa
srv -> db: Marcar usuario suspendido
db --> srv: Usuario actualizado
srv -> db: Invalidar sesiones activas y registrar auditoria
db --> srv: Sesiones cerradas
srv --> api: Suspension completada
api --> ui: Usuario suspendido
ui --> admin: El usuario ya no puede iniciar sesion

@enduml

