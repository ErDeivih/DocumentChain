@startuml
!include _structure-style.puml
title Arquitectura funcional del sistema

package "Presentacion" {
    [Aplicacion web] as React
    [Wallet del usuario] as Wallet
    [Canal tiempo real cliente] as SIOClient
}

package "Capa de aplicacion" {
    [Rutas] as Router
    [Autenticacion y permisos] as Auth
    [Servicios de dominio] as Svc
    [Canal tiempo real servidor] as SIOServer
    [Sincronizador blockchain] as EvtListener
}

package "Capa de persistencia" {
    [Repositorios] as Repo
    database "Base de datos" as DB
}

package "Almacenamiento distribuido" {
    [IPFS compatible] as IPFS
}

package "Red blockchain" {
    [DocumentRegistry] as SC
    [Nodo blockchain de prueba] as ETH
}

package "Comunicacion asincrona" {
    [Servicio de email] as Email
    [Servicio de notificaciones] as Notif
}

React --> Router : HTTPS
React --> Wallet : firma de operaciones
React --> SIOClient
SIOClient <--> SIOServer
Router --> Auth
Auth --> Svc
Svc --> Repo
Repo --> DB
Svc --> IPFS
Svc --> SC
Svc --> Email
EvtListener --> ETH
EvtListener --> Repo
EvtListener --> SIOServer
@enduml


