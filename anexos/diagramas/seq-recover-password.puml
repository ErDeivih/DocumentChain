@startuml

title Recover Password
!include _sequence-style.puml
title UC-0012: Recuperar contrasena

actor Usuario as user
boundary "ForgotPassword.tsx" as ui
control "AuthController (/api/auth)" as api
control "AuthService" as srv
control "EmailService" as email
database "Base de datos" as db

user -> ui: Introduce email de recuperacion
ui -> api: POST /api/auth/forgot-password {email}
api -> srv: requestPasswordReset(email)
srv -> db: Buscar usuario y generar token temporal
db --> srv: Token de recuperacion registrado
srv -> email: Enviar enlace de recuperacion
email --> srv: Email aceptado para envio
srv --> api: Respuesta generica de seguridad
api --> ui: 200 OK
ui --> user: Muestra instrucciones de recuperacion

@enduml
