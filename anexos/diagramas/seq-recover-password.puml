@startuml
!include _sequence-style.puml
actor Usuario as user
boundary "Pagina Recuperar" as ui
control "Endpoints de recuperacion y correo (/api/email)" as api
control "AuthService" as srv
database "PostgreSQL" as db
control "EmailService" as email

== Solicitud ==
user -> ui: Solicita recuperar la contrasena
ui -> api: Pedir enlace de restablecimiento
api -> srv: Generar token si la cuenta existe
srv -> db: Registrar solicitud valida
srv -> email: Enviar enlace al correo
email --> srv: OK
srv --> api: Solicitud procesada
api --> ui: Mostrar mensaje neutro

== Restablecimiento ==
user -> ui: Abre el enlace y define nueva contrasena
ui -> api: Confirmar restablecimiento
api -> srv: Validar token y recovery key
srv -> db: Actualizar credenciales y borrar token
db --> srv: OK
srv --> api: Contrasena actualizada
api --> ui: Restablecimiento completado
ui --> user: Redirige a inicio de sesion

@enduml

