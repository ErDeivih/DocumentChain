@startuml
!include _sequence-bce-style.puml

title UC-0024: Establecer Version Operativa (Analisis BCE)

actor Actor
boundary "PanelVersiones" as BF
control "GestorVersiones" as CV
entity "Version" as EV
entity "Documento" as ED

database "Base de datos" as DB
boundary "Blockchain" as BC

Actor -> BF : 1. Selecciona version como operativa
BF -> CV : 2. Peticion de cambio de version operativa
CV -> EV : 3. Verifica existencia de la version
EV -> DB : consulta version
DB --> EV : datos version
EV --> CV : version existente

CV -> ED : 4. Verifica propiedad
ED -> DB : consulta propietario
DB --> ED : propietario actual
ED --> CV : propiedad confirmada

CV -> BC : 5. Registra cambio en blockchain
BC --> CV : confirmacion on-chain

CV -> EV : 6. Actualiza version operativa
EV -> DB : UPDATE operational_version
DB --> EV : confirmacion
EV --> CV : version operativa actualizada

CV --> BF : 7. Confirmacion
BF --> Actor : 8. Muestra nueva version activa

@enduml


