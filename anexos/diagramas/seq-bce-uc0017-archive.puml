@startuml
!include _sequence-bce-style.puml

title UC-0017: Archivar Documento (Analisis BCE)

actor Actor
boundary "Biblioteca" as BB
control "GestorDocumentos" as CD
entity "Documento" as ED

database "Base de datos" as DB
boundary "Blockchain" as BC

Actor -> BB : 1. Selecciona archivar documento
BB -> CD : 2. Peticion de archivado
CD -> ED : 3. Verifica propiedad
ED -> DB : consulta propietario
DB --> ED : datos propietario
ED --> CD : propiedad confirmada

CD -> ED : 4. Actualiza archivado = true
ED -> DB : UPDATE documento archivado
DB --> ED : confirmacion
ED --> CD : estado actualizado

CD -> BC : 5. Registra cambio en blockchain
BC --> CD : confirmacion on-chain

CD --> BB : 6. Estado archivado actualizado
BB --> Actor : 7. Muestra estado archivado

@enduml

