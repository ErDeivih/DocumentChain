@startuml
!include _sequence-bce-style.puml

title UC-0018: Desarchivar Documento (Analisis BCE)

actor Actor
boundary "VistaDocumento" as BF
control "GestorDocumentos" as CG
entity "Documento" as ED

database "Base de datos" as DB

Actor -> BF : 1. Solicita desarchivar documento
BF -> CG : 2. Peticion de desarchivado
CG -> ED : 3. Verifica que el documento esta archivado
ED -> DB : consulta estado documento
DB --> ED : estado ARCHIVED
ED --> CG : documento archivado confirmado

CG -> ED : 4. Verifica propiedad
ED -> DB : consulta propietario
DB --> ED : propietario confirmado
ED --> CG : permiso verificado

CG -> ED : 5. Cambia estado a activo
ED -> DB : UPDATE status = SYNCED
DB --> ED : confirmacion
ED --> CG : documento desarchivado

CG --> BF : 6. Confirmacion
BF --> Actor : 7. Muestra documento en lista activa

@enduml


