@startuml
!include _sequence-style.puml
actor Usuario as user
boundary "Ajustes / Seguridad" as ui
control "Endpoints de 2FA (/api/auth/2fa)" as api
control "TwoFactorService" as srv
database "PostgreSQL" as db

user -> ui: Solicita nuevos codigos de respaldo
ui -> api: Regenerar codigos
api -> srv: Verificar que 2FA esta activo
srv -> srv: Generar nueva tanda de codigos
srv -> db: Sustituir codigos anteriores
db --> srv: OK
srv --> api: Codigos en claro para una sola visualizacion
api --> ui: Mostrar nuevos codigos
ui --> user: Confirmar guardado seguro
@enduml

