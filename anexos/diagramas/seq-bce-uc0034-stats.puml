@startuml
!include _sequence-bce-style.puml

title UC-0034: Ver Estadisticas Personales (Analisis BCE)

actor Actor
boundary "PanelEstadisticas" as PE
control "GestorEstadisticas" as CE
entity "Metrica" as EM

database "Base de datos" as DB
boundary "Blockchain" as BC

Actor -> PE : 1. Accede a estadisticas
PE -> CE : 2. Solicita metricas del usuario
CE -> EM : 3. Consulta metricas del usuario
EM -> DB : SELECT metricas / agregaciones
DB --> EM : datos agregados
EM --> CE : retorna metricas

CE -> BC : 4. Consulta datos blockchain
BC --> CE : transacciones y actividad on-chain

CE --> PE : 5. Retorna datos combinados
PE --> Actor : 6. Renderiza graficos y resumen

@enduml

