@startuml
!include _sequence-style.puml
actor Administrador as admin
boundary "Panel de administracion" as ui
control "Endpoints de administracion (/api/admin)" as api
control "AdminUserService" as srv
database "PostgreSQL" as db

admin -> ui: Solicita eliminar una cuenta
ui -> ui: Muestra advertencia irreversible
admin -> ui: Confirma la eliminacion
ui -> api: Solicitar borrado administrativo
api -> srv: Validar que no sea autoeliminacion
srv -> db: Eliminar cuenta y dependencias aplicables
db --> srv: Cuenta eliminada
srv --> api: Borrado completado
api --> ui: Lista actualizada
ui --> admin: Cuenta retirada del sistema
@enduml

