actor "Administrador" as ADMIN
actor "Blockchain" as SC

rectangle "Modulo de auditoria y estadisticas" {
  usecase "UC-0033: Ver Timeline" as UC33
  usecase "UC-0034: Ver Estadisticas Personales" as UC34
