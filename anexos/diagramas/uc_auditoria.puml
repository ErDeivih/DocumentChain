  usecase "UC-0036: Verificar Autenticidad" as UC36
  usecase "UC-0037: Auditoria Blockchain" as UC37
}

UC33 -[hidden]down-> UC34
UC34 -[hidden]down-> UC35
UC35 -[hidden]down-> UC36
UC36 -[hidden]down-> UC37

USER --> UC33
USER --> UC34
USER --> UC36
