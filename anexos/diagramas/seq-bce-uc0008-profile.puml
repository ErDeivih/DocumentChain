@startuml
!include _sequence-bce-style.puml

title UC-0008: Gestionar Perfil (Análisis)

actor "Usuario logueado" as Actor
boundary "Interfaz Perfil" as BU
control "Controlador Usuario" as CO
entity "Usuario" as EU

Actor -> BU : Accede a pagina de perfil
BU -> CO : ObtenerPerfil(userId)
CO -> EU : Recupera datos del usuario
EU --> CO : Datos del perfil
CO --> BU : Datos de perfil
BU --> Actor : Muestra datos y opciones
Actor -> BU : Modifica datos (avatar, nombre, biografia)
BU -> CO : ActualizarPerfil(datos)
CO -> EU : Actualiza datos del usuario
EU --> CO : Confirmacion
CO --> BU : Perfil actualizado
BU --> Actor : Muestra perfil actualizado

@enduml
