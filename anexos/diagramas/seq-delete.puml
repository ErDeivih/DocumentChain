@startuml
!include _sequence-style.puml
actor Usuario as user
boundary "Detalle de documento" as ui
control "Endpoints de documentos (/api/documents)" as api
control "DocumentService" as srv
entity "DocumentRegistry" as sc
entity "IPFSService" as ipfs
database "Base de datos" as db
participant "Wallet del usuario (navegador o WalletConnect)" as wallet
control "EventListenerService" as listener

user -> ui: Solicita eliminar el documento
ui -> api: Preparar eliminacion
api -> srv: Validar propiedad y recopilar recursos asociados
srv -> sc: isOwner(blockchainId, walletAddress)
sc --> srv: Propietario validado
srv -> db: Registrar eliminacion preparada
db --> srv: Datos para firmar
srv --> api: Payload blockchain
api --> ui: Eliminacion preparada

ui -> wallet: Solicitar firma de borrado
wallet -> sc: Registrar eliminacion on-chain
sc --> wallet: txHash
wallet --> ui: txHash

ui -> api: Confirmar eliminacion
api -> srv: Registrar TX_SUBMITTED
srv -> sc: getTransactionReceipt(txHash)
sc --> srv: receipt status=1 + DocumentDeleted
srv -> db: Actualizar estado transaccional
db --> srv: OK
srv --> api: Pendiente de sincronizacion
api --> ui: Confirmacion registrada

sc -> listener: Evento DocumentDeleted(docId, timestamp)
listener -> ipfs: Unpin de CIDs asociados
listener -> db: Marcar documento eliminado y registrar auditoria
listener -> ui: Refrescar biblioteca
ui --> user: Documento retirado de la aplicacion
@enduml

