@startuml
!include _sequence-bce-style.puml

title UC-0015: Ver Detalle de Documento (Analisis BCE)

actor Actor
boundary "VistaDetalle" as VD
control "GestorDocumentos" as CD
entity "Documento" as ED

database "Base de datos" as DB
boundary "Blockchain" as BC

Actor -> VD : 1. Selecciona documento
VD -> CD : 2. Solicita detalle
CD -> ED : 3. Recupera Entity Documento
ED -> DB : SELECT documento
DB --> ED : datos del documento
ED --> CD : documento recuperado

CD -> DB : 4. Consulta versiones
DB --> CD : lista de versiones

CD -> DB : 5. Consulta firmas
DB --> CD : lista de firmas

CD -> BC : 6. Consulta permisos blockchain
BC --> CD : permisos on-chain

CD --> VD : 7. Retorna detalle completo
VD --> Actor : 8. Renderiza detalle completo

@enduml

