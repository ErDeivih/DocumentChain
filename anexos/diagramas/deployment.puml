@startuml
!include _structure-style.puml
title Diagrama de despliegue

node "Cliente" as cliente {
    component "Aplicacion web" as frontend
    component "Wallet del usuario" as wallet
}

node "Servidor de aplicacion" as backend_node {
    component "Frontend Nginx" as web
    component "API backend" as backend
    component "Sincronizador blockchain" as listeners
    component "Canal tiempo real" as ws
    component "Nodo Hardhat local" as hardhat
    component "Postfix SMTP" as postfix
}

node "Capa de persistencia" as db_node {
    database "Base de datos" as db
}

cloud "Proveedor IPFS-compatible" as ipfs_node {
    component "Pinata por defecto" as pinata
    component "Kubo opcional" as kubo
}

cloud "Red blockchain" as ethereum {
    component "DocumentRegistry" as contract
}

frontend --> web : HTTPS
web --> backend : /api
frontend --> wallet : firma de operaciones
wallet --> hardhat : JSON-RPC local
hardhat --> contract
backend --> db
backend --> pinata
backend ..> kubo : si IPFS_PROVIDER=self-hosted
backend --> postfix
listeners --> hardhat
listeners --> db
ws --> frontend : notificaciones

@enduml


