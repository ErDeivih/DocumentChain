@startuml
!include _structure-style.puml

title Diagrama de Actividad: Subida de Documento con Firma

start

:Usuario selecciona archivo y metadatos;

:Frontend envia archivo en bruto y metadatos al backend;

:POST /api/documents/prepare\n(multipart/form-data);

:Backend valida archivo, wallet y metadatos;

if (Documento privado?) then (si)
  :Backend cifra el contenido con AES-256-GCM\ny protege la clave simetrica para el propietario;
else (no)
  :Backend conserva el contenido en claro\ny genera publicId para acceso publico;
endif

:Backend almacena el contenido en IPFS\n(obtiene CID);

:Backend crea documento y version inicial\nen Base de datos (estado PREPARING);

:Backend construye datos de transaccion\n(messageToSign / payload para wallet);

:Backend devuelve transactionData al frontend;

:Frontend presenta mensaje legible al usuario;

if (Usuario firma?) then (si)
  :Wallet del usuario firma y envia\nla transaccion al contrato;
  
  :POST /api/documents/confirm\n(envia documentId, txHash y blockchainId);
  
  :Backend marca el documento como TX_SUBMITTED;

  :EventListenerService detecta\nDocumentCreated en blockchain;
  
  if (Evento confirmado?) then (si)
    :Backend actualiza Base de datos\n(estado: SYNCED);
    :Backend notifica al frontend via WebSocket;
    :Frontend actualiza lista de documentos;
  else (no / revertido)
    :Backend marca estado FAILED;
    :Notifica error al usuario;
  endif
  
else (no)
  :El registro PREPARING queda sin confirmar\ny expira por timeout de sincronizacion;
  :Operacion cancelada sin efectos on-chain;
endif

stop

@enduml

