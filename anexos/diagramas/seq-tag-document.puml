@startuml
!include _sequence-style.puml
actor Usuario as user
boundary "Detalle / Etiquetas" as ui
control "Endpoints de documentos (/api/documents/:id)" as api
control "DocumentService" as srv
database "PostgreSQL" as db

user -> ui: Edita las etiquetas (tags) del documento
ui -> api: Guardar tags
api -> srv: Validar permisos y actualizar tags
srv -> db: Actualizar campo tags del documento
db --> srv: OK
srv --> api: Tags actualizados
api --> ui: Vista refrescada
ui --> user: Etiquetas visibles en el detalle

@enduml

