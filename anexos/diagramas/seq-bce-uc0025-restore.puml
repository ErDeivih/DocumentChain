@startuml
!include _sequence-bce-style.puml

title UC-0025: Restaurar Version Anterior (Analisis BCE)

actor Actor
boundary "PanelVersiones" as BF
control "GestorVersiones" as CV
entity "Version" as EV
entity "Documento" as ED

database "Base de datos" as DB
boundary "Blockchain" as BC

Actor -> BF : 1. Selecciona restaurar version
BF -> CV : 2. Peticion de restauracion
CV -> EV : 3. Verifica existencia de version anterior
EV -> DB : consulta version
DB --> EV : datos version anterior
EV --> CV : version encontrada

CV -> ED : 4. Verifica propiedad
ED -> DB : consulta propietario
DB --> ED : propietario confirmado
ED --> CV : permiso verificado

CV -> BC : 5. Registra restauracion en blockchain
BC --> CV : confirmacion on-chain

CV -> EV : 6. Restaura contenido de la version
note right : Control restablece el CID de la version anterior como contenido activo

CV -> ED : 7. Actualiza referencia del documento
ED -> DB : UPDATE documento con version restaurada
DB --> ED : confirmacion
ED --> CV : documento actualizado

CV --> BF : 8. Confirmacion
BF --> Actor : 9. Muestra documento restaurado

@enduml


