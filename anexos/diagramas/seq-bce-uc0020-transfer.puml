@startuml
!include _sequence-bce-style.puml

title UC-0020: Transferir Documento (Analisis BCE)

actor Actor
boundary "ModalTransferencia" as BT
control "GestorTransferencia" as CT
entity "Documento" as ED

database "Base de datos" as DB
boundary "Blockchain" as BC

Actor -> BT : 1. Introduce nuevo propietario
BT -> CT : 2. Envia direccion del nuevo propietario
CT -> ED : 3. Valida propiedad actual
ED -> DB : consulta propietario
DB --> ED : datos actuales
ED --> CT : propiedad confirmada

CT -> BC : 4. Transfiere permisos en blockchain
BC --> CT : confirmacion on-chain

CT -> ED : 5. Actualiza propietario
ED -> DB : UPDATE documento propietario
DB --> ED : confirmacion
ED --> CT : propietario actualizado

CT -> CT : 6. Revoca permisos antiguos
note right : Control elimina o restringe permisos del antiguo propietario

CT --> BT : 7. Confirmacion de transferencia
BT --> Actor : 8. Muestra confirmacion

@enduml

