@startuml
!include _sequence-style.puml
actor Usuario as user
boundary "Detalle / Compartir" as ui
control "Endpoints de comparticion\n(/api/documents/:id/share y /api/shares)" as shareApi
control "ShareService" as srv
entity "DocumentRegistry" as sc
participant "Wallet del usuario\n(navegador o WalletConnect)" as wallet
database "Base de datos" as db
participant "Sincronizador blockchain" as listener

== Fase PREPARE ==
user -> ui: Click en "Revocar acceso" para un usuario compartido
ui -> shareApi: POST /api/documents/:documentId/share/:userId/revoke/prepare {sharerWalletId}
shareApi -> srv: prepareRevokeShare(documentId, userId, ownerId, sharerWalletId)
srv -> sc: isOwner(blockchainId, walletAddress)
sc --> srv: Propietario validado
srv -> sc: getDocumentUsersWithRoles (verificar acceso activo)
sc --> srv: Usuario tiene acceso
srv -> db: Recuperar acceso y wallet destinataria
db --> srv: Datos para la revocacion
srv -> db: Registrar evento SHARE_REVOKE_PREPARED
db --> srv: shareId, blockchainId, sharedWithAddress
srv --> shareApi: {shareId, blockchainId, sharedWithAddress}
shareApi --> ui: Revocacion preparada

== Fase CONFIRM ==
ui -> wallet: Firmar y enviar revokePermission(blockchainId, sharedWithAddress)
user -> wallet: Aprueba la operacion
wallet --> ui: txHash
ui -> shareApi: POST /api/shares/revoke/confirm {shareId, txHash}
shareApi -> srv: confirmRevokeShare(shareId, txHash)
srv -> sc: getTransactionReceipt(txHash)
sc --> srv: receipt status=1 + PermissionRevoked
srv -> db: Registrar evento SHARE_REVOKED y notificacion al afectado
db --> srv: OK
srv --> shareApi: Confirmacion registrada
shareApi --> ui: Revocacion enviada

== Fase SYNC ==
sc -> listener: Emite PermissionRevoked(docId, user, timestamp)
listener -> db: Registrar auditoria on-chain si no existe
listener -> ui: Refrescar lista de accesos
ui --> user: Acceso revocado correctamente

@enduml
