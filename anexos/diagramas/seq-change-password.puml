@startuml
!include _sequence-style.puml
actor Usuario as user
boundary "Ajustes / Seguridad" as ui
control "Endpoints de autenticacion\n(/api/auth)" as authApi
control "Servicio de autenticacion" as srv
control "KeyManager" as crypto
database "Base de datos" as db

user -> ui: Introduce contrasena actual y nueva contrasena
ui -> crypto: Reproteger la clave privada con la nueva contrasena
crypto --> ui: Nueva clave cifrada
ui -> authApi: Solicitar cambio de contrasena
authApi -> srv: Validar credenciales actuales y actualizar secretos
alt Contrasena actual incorrecta
  srv --> authApi: Error de validacion
  authApi --> ui: Mostrar error de autenticacion
else Cambio valido
  srv -> db: Actualizar hash y clave privada protegida
  db --> srv: OK
  srv --> authApi: Cambio completado
  authApi --> ui: Pedir nuevo inicio de sesion
  ui --> user: Contrasena actualizada
end

@enduml


