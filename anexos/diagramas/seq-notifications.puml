@startuml
!include _sequence-style.puml
actor Usuario as user
boundary "Panel de Notificaciones" as ui
control "Endpoints de notificaciones\n(/api/notifications)" as notifApi
control "Servicio de notificaciones" as srv
database "PostgreSQL" as db

user -> ui: Click en icono de notificaciones
ui -> notifApi: Solicitar listado y contador pendiente
notifApi -> srv: Recuperar notificaciones del usuario
srv -> db: Consultar listado y resumen de lectura
db --> srv: Notificaciones disponibles
srv --> notifApi: Datos listos para la vista
notifApi --> ui: Panel cargado
ui --> user: Muestra listado de notificaciones

== Marcar como leida ==
user -> ui: Click en notificacion especifica
ui -> notifApi: Marcar notificacion como leida
notifApi -> srv: Actualizar estado de lectura
srv -> db: Persistir cambio y recalcular contador
db --> srv: OK
srv --> notifApi: Cambio confirmado
notifApi --> ui: Actualizar listado y badge

@enduml

