@startuml

title Unarchive
!include _sequence-style.puml
actor Usuario as user
boundary "Detalle de documento" as ui
control "Endpoints de documentos (/api/documents)" as api
control "DocumentService" as srv
entity "DocumentRegistry" as sc
database "Base de datos" as db
participant "Wallet del usuario (navegador o WalletConnect)" as wallet
control "EventListenerService" as listener

user -> ui: Solicita desarchivar el documento
ui -> api: Preparar desarchivado
api -> srv: Validar propiedad y estado archivado
srv -> sc: isOwner(blockchainId, walletAddress)
sc --> srv: Propietario validado
srv -> db: Registrar operacion preparada
db --> srv: Datos para firmar
srv --> api: Payload blockchain
api --> ui: Desarchivado preparado

ui -> wallet: Solicitar firma
wallet -> sc: Registrar desarchivado on-chain
sc --> wallet: txHash
wallet --> ui: txHash

ui -> api: Confirmar desarchivado
api -> srv: Registrar TX_SUBMITTED
srv -> db: Actualizar estado transaccional
db --> srv: OK
srv --> api: Pendiente de sincronizacion
api --> ui: Confirmacion registrada

sc -> listener: Evento de desarchivado confirmado
listener -> db: Marcar documento activo y SYNCED
listener -> ui: Refrescar biblioteca
ui --> user: Documento devuelto a la vista principal
@enduml

