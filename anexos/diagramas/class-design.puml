@startuml
!include _structure-style.puml
title Diagrama de clases de diseno - capa de negocio

skinparam classAttributeIconSize 0
skinparam classFontSize 11
hide empty members

package "Controllers (Express.js)" #DDEEFF {
    class AuthController {
        +register(req, res): void
        +login(req, res): void
        +logout(req, res): void
        +forgotPassword(req, res): void
        +verifyEmail(req, res): void
    }
    class EmailController {
        +verifyEmail(req, res): void
        +forgotPassword(req, res): void
    }
    class DocumentController {
        +prepareDocument(req, res): void
        +confirmDocument(req, res): void
        +getDocument(req, res): void
        +downloadDocument(req, res): void
        +listDocuments(req, res): void
        +getDocumentsByWallet(req, res): void
        +prepareArchiveDocument(req, res): void
        +confirmArchiveDocument(req, res): void
        +prepareUnarchiveDocument(req, res): void
        +confirmUnarchiveDocument(req, res): void
        +prepareTransferDocument(req, res): void
        +confirmTransferDocument(req, res): void
    }
    class SignatureController {
        +prepareSignature(req, res): void
        +confirmSignature(req, res): void
        +getDocumentSignatures(req, res): void
        +verifySignature(req, res): void
    }
    class ShareController {
        +prepareShare(req, res): void
        +confirmShare(req, res): void
        +getDocumentShares(req, res): void
        +revokeAccess(req, res): void
    }
    class UserController {
        +getAllUsers(req, res): void
        +deleteUser(req, res): void
    }
    class AdminController {
        +getAllUsers(req, res): void
        +updateUserRole(req, res): void
        +createAdminUser(req, res): void
        +deleteUser(req, res): void
        +getSystemStats(req, res): void
    }
}

package "Services (Logica de Negocio)" #DFFFDF {
    class AuthService {
        -jwtSecret: string
        +register(data): Promise<User>
        +login(email, pwd): Promise<{token, user}>
        +logout(userId): Promise<void>
        +sendPasswordReset(email): Promise<void>
        +resetPassword(token, password): Promise<void>
    }
    class EmailService {
        +sendVerificationEmail(to, token): Promise<void>
        +sendPasswordResetEmail(to, token): Promise<void>
        +sendDocumentSharedEmail(to, info): Promise<void>
        +sendDocumentSignedEmail(to, info): Promise<void>
    }
    class DocumentService {
        +prepareDocument(input): Promise<PrepareDocumentResult>
        +confirmDocument(input): Promise<DocumentInfo>
        +getDocumentById(documentId, userId): Promise<DocumentInfo | null>
        +listDocuments(userId, filters): Promise<DocumentInfo[]>
        +downloadDocument(documentId, userId): Promise<{fileBuffer, fileName}>
        +prepareArchiveDocument(documentId, userId): Promise<any>
        +confirmArchiveDocument(input): Promise<any>
        +prepareUnarchiveDocument(documentId, userId): Promise<any>
        +confirmUnarchiveDocument(input): Promise<any>
        +prepareTransferDocument(documentId, newOwner): Promise<any>
        +confirmTransferDocument(input): Promise<any>
    }
    class IPFSService {
        -gateway: string
        +uploadFile(buffer, name): Promise<string>
        +downloadFile(cid): Promise<Buffer>
        +pinFile(cid): Promise<void>
        +unpinFile(cid): Promise<void>
        +isAvailable(cid): Promise<boolean>
    }
    class ShareService {
        +prepareShare(documentId, recipientUserId, role): Promise<any>
        +confirmShare(shareId, txHash): Promise<any>
        +getDocumentShares(documentId, userId): Promise<any[]>
        +revokeAccess(shareId, userId): Promise<void>
    }
    class SignatureService {
        +prepareSignature(docId, userId): Promise<any>
        +confirmSignature(txHash, docId, userId): Promise<any>
        +getDocumentSignatures(documentId, requesterUserId): Promise<any[]>
        +verifySignature(signatureId): Promise<boolean>
    }
    class NotificationService {
        +createNotification(userId, type, data): Promise<void>
        +markAllAsRead(userId): Promise<void>
        +broadcastSocket(event, data): void
    }
    class UserService {
        +getAllUsers(page, limit): Promise<any>
        +deleteUser(userId): Promise<void>
    }
    class DocumentPermissionService {
        +getDocumentUsers(docId): Promise<string[]>
        +getDocumentUsersWithRoles(docId): Promise<any[]>
        +hasAccess(userId, docId, role): Promise<boolean>
    }
    class VersionService {
        +getDocumentVersions(documentId, userId): Promise<any[]>
    }
    class DocumentTimelineService {
        +getDocumentTimeline(documentId, userId): Promise<any[]>
    }
    class BlockchainAdminService {
        +grantAdminRole(walletAddress): Promise<any>
        +revokeAdminRole(walletAddress): Promise<any>
        +syncAllAdmins(): Promise<any>
    }
    class BlockchainCacheService {
        +getDocumentState(blockchainId): Promise<DocState>
        +invalidateCache(blockchainId): void
    }
    class TransferService {
        +prepareTransfer(docId, newOwnerId, walletId): Promise<any>
        +confirmTransfer(txHash, docId): Promise<any>
    }
    class BlockchainReconciler {
        +start(): void
        +stop(): void
        -reconcile(): Promise<void>
    }
}

package "Repositories (Acceso a Datos)" #FFFDE7 {
    class UserRepository {
        +findById(id): Promise<User>
        +findByEmail(email): Promise<User>
        +create(data): Promise<User>
        +update(id, data): Promise<User>
    }
    class DocumentRepository {
        +findById(id): Promise<Document>
        +findByOwner(userId): Promise<Document[]>
        +create(data): Promise<Document>
        +update(id, data): Promise<Document>
        +delete(id): Promise<void>
    }
    class SignatureRepository {
        +findByDocument(docId): Promise<Signature[]>
        +findByTxHash(hash): Promise<Signature>
        +create(data): Promise<Signature>
        +update(id, data): Promise<Signature>
    }
}

class EventListener {
    +listenDocumentCreated(): void
    +listenDocumentSigned(): void
    +listenDocumentTransferred(): void
    -handleDocumentCreated(event): void
    -handleDocumentSigned(event): void
}

' Dependencias
AuthController ..> AuthService
AuthController ..> EmailService
EmailController ..> EmailService
DocumentController ..> DocumentService
SignatureController ..> SignatureService
ShareController ..> ShareService
UserController ..> UserService
AdminController ..> UserService
AdminController ..> BlockchainAdminService

AuthService ..> UserRepository
AuthService ..> EmailService
DocumentService ..> IPFSService
DocumentService ..> ShareService
DocumentService ..> DocumentRepository
DocumentService ..> NotificationService
SignatureService ..> DocumentPermissionService
SignatureService ..> SignatureRepository
SignatureService ..> DocumentRepository
ShareService ..> DocumentPermissionService
ShareService ..> NotificationService
ShareService ..> EmailService
UserService ..> UserRepository
VersionService ..> DocumentRepository
DocumentTimelineService ..> DocumentRepository
DocumentPermissionService ..> DocumentRepository
BlockchainAdminService ..> UserRepository

EventListener ..> DocumentRepository
EventListener ..> SignatureRepository
EventListener ..> NotificationService
@enduml

