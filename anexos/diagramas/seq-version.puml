@startuml
!include _sequence-style.puml
actor Usuario as user
boundary "UploadVersionModal.tsx" as ui
control "VersionController (/api/documents/:id/versions)" as api
control "VersionService" as srv
control "DocumentPermissionService" as perm
entity "DocumentRegistry" as sc
control "IPFSService" as ipfs
entity "Document" as doc
entity "DocumentVersion" as ver
database "Base de datos" as db
participant "Wallet (EIP-6963 / WalletConnect)" as wallet
control "EventListenerService" as listener

user -> ui: Selecciona archivo y comentario para nueva version
ui -> api: POST /api/documents/:documentId/versions/prepare (multipart/form-data)
api -> srv: prepareVersion(documentId, file, comment, userId, walletId)
srv -> perm: isOwner / canEdit(blockchainId, walletAddress)
perm -> sc: getUserPermission(docId, userAddress)
sc --> perm: DocumentRole.OWNER o EDITOR
perm --> srv: Permiso de escritura validado
srv -> doc: Cargar metadatos de documento y modo de privacidad
doc -> db: Obtener blockchainId, ownerPublicKey, visibilidad
db --> doc: Documento operativo
doc --> srv: Contexto de versionado
alt Documento privado
    srv -> srv: generateSymmetricKey() + cifrar contenido con AES-256-GCM
    srv -> srv: encryptSymmetricKeyWithPublicKey(ownerPublicKey)
else Documento publico
    srv -> srv: Mantener contenido en claro, preservar publicId
end
srv -> ipfs: uploadFile(buffer, filename)
ipfs --> srv: CID
srv -> ver: Crear version en estado PREPARING
ver -> db: Persistir CID, comentario y metadatos de cifrado
db --> ver: {versionId, versionNumber, blockchainId}
ver --> srv: Version preparada
srv --> api: {versionId, versionNumber, blockchainId, messageToSign}
api --> ui: 200 OK version preparada

ui -> wallet: eth_signTypedData_v4(messageToSign)
wallet -> sc: createVersion(docId, cid, metadataHash)
sc --> wallet: txHash
wallet --> ui: txHash

ui -> api: POST /api/documents/:documentId/versions/confirm {versionId, txHash, walletAddress}
api -> srv: confirmVersion(versionId, txHash, walletAddress)
srv -> ver: Marcar transaccion enviada
ver -> db: Actualizar estado a TX_SUBMITTED y guardar txHash
db --> ver: OK
ver --> srv: Confirmacion persistida
srv --> api: {status: "TX_SUBMITTED"}
api --> ui: 200 OK confirmacion registrada

sc -> listener: Evento VersionCreated(docId, versionNumber, cid, timestamp)
listener -> ver: Resolver version por docId + versionNumber
ver -> db: Actualizar version a SYNCED y fecha de bloque
db --> ver: Version sincronizada
listener -> db: Registrar evento de timeline asociado
listener -> ui: WebSocket / refrescar pestana Versiones
ui --> user: Nueva version disponible en el historial

@enduml

