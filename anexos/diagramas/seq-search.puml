@startuml
!include _sequence-style.puml
actor Usuario as user
boundary "Biblioteca / Busqueda" as ui
control "Endpoints de documentos (/api/documents)" as api
control "DocumentService" as srv
database "PostgreSQL" as db

user -> ui: Introduce termino y filtros
ui -> api: Solicitar resultados filtrados
api -> srv: Construir consulta segun filtros y permisos
srv -> db: Recuperar coincidencias ordenadas
db --> srv: Resultados y total
srv --> api: Respuesta de busqueda
api --> ui: Lista filtrada
ui --> user: Resultados actualizados

@enduml

