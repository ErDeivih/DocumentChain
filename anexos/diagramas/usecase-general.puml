@startuml
!include _structure-style.puml
left to right direction
title Mapa global de casos de uso

actor "Usuario" as USER
actor "Administrador" as ADMIN
actor "Blockchain" as SC
actor "IPFS" as IPFS
actor "Sistema de email" as EMAIL

rectangle "DocumentChain" {
  package "Acceso y cuenta" {
    usecase "UC-0001 a UC-0012\nRegistro, acceso, wallet,\nperfil y seguridad" as UC_A
  }

  package "Gestion de documentos" {
    usecase "UC-0013 a UC-0021\nCarga, consulta, descarga,\narchivo y busqueda" as UC_B
  }

  package "Gestion de versiones" {
    usecase "UC-0022 a UC-0026\nVersiones y estado operativo" as UC_C
  }

  package "Firmas" {
    usecase "UC-0027 a UC-0029\nFirma y verificacion de firmas" as UC_D
  }

  package "Gestion de comparticion" {
    usecase "UC-0030 a UC-0032\nPermisos y acceso compartido" as UC_E
  }

  package "Auditoria, verificacion\ny estadisticas" {
    usecase "UC-0033 a UC-0037\nTimeline, verificacion\ny supervision" as UC_F
  }

  package "Administracion" {
    usecase "UC-0038 a UC-0039\nUsuarios y roles" as UC_G
  }
}

USER --> UC_A
USER --> UC_B
USER --> UC_C
USER --> UC_D
USER --> UC_E
USER --> UC_F

ADMIN --> UC_F
ADMIN --> UC_G

UC_A -[hidden]down-> UC_B
UC_B -[hidden]down-> UC_C
UC_C -[hidden]down-> UC_D
UC_D -[hidden]down-> UC_E
UC_E -[hidden]down-> UC_F
UC_F -[hidden]down-> UC_G

UC_A ..> EMAIL : verificaciones y avisos
UC_B ..> IPFS : almacenamiento de contenido
UC_B ..> SC : registro documental
UC_C ..> IPFS : nuevas versiones
UC_C ..> SC : trazabilidad de versiones
UC_D ..> SC : firmas
UC_E ..> SC : permisos
UC_F ..> SC : verificacion y auditoria

note right of UC_F
  Subflujos integrados en el catalogo consolidado:
  notificaciones, preferencias de usuario,
  verificacion de integridad y estadisticas.
end note
@enduml
