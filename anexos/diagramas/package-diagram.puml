@startuml package-diagram
!include _structure-style.puml
package "Cliente web" {
    [Pages]
    [Components]
    [Integracion API]
    [Crypto Utils]
    [Blockchain Utils]
    [Context Providers]
}

package "Servidor de aplicacion" {
    [Rutas]
    [Controladores]
    [Servicios]
    [Middleware]
}

package "Persistencia" {
    [Capa de acceso a base de datos]
    [Base de datos]
}

package "Infraestructura" {
    [Cliente IPFS]
    [Cliente blockchain]
    [Sincronizador blockchain]
    [Servicio de email]
    [WebSocket]
}

package "Blockchain" {
    [DocumentRegistry]
    [Nodo blockchain]
}

package "Storage" {
    [IPFS compatible]
}

[Pages] --> [Components]
[Pages] --> [Integracion API]
[Pages] --> [Blockchain Utils]
[Integracion API] --> [Controladores]
[Blockchain Utils] --> [DocumentRegistry]
[Controladores] --> [Servicios]
[Servicios] --> [Capa de acceso a base de datos]
[Servicios] --> [Cliente IPFS]
[Servicios] --> [Cliente blockchain]
[Capa de acceso a base de datos] --> [Base de datos]
[Cliente IPFS] --> [IPFS compatible]
[Cliente blockchain] --> [DocumentRegistry]
[DocumentRegistry] --> [Nodo blockchain]
[Sincronizador blockchain] --> [DocumentRegistry]
[Sincronizador blockchain] --> [Capa de acceso a base de datos]
@enduml


