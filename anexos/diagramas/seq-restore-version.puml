@startuml
!include _sequence-style.puml
actor Usuario as user
boundary "Historial de versiones" as ui
control "Endpoints de versiones (/api/documents/:id/versions)" as api
control "VersionService" as srv
entity "DocumentRegistry" as sc
entity "IPFSService" as ipfs
database "Base de datos" as db
participant "Wallet del usuario (navegador o WalletConnect)" as wallet
control "EventListenerService" as listener

user -> ui: Selecciona una version anterior para restaurarla
ui -> api: Preparar restauracion
api -> srv: Validar permisos y version origen
srv -> sc: isOwner(blockchainId, walletAddress)
sc --> srv: Propietario validado
srv -> db: Recuperar version seleccionada y crear restauracion en PREPARING
db --> srv: Datos de version y nueva restauracion
srv -> ipfs: Reutilizar el contenido asociado a la version origen
ipfs --> srv: Referencia disponible
srv --> api: Datos para firmar la restauracion
api --> ui: Restauracion preparada

ui -> wallet: Solicitar firma de nueva version restaurada
wallet -> sc: Registrar restauracion on-chain
sc --> wallet: txHash
wallet --> ui: txHash

ui -> api: Confirmar restauracion
api -> srv: Registrar TX_SUBMITTED
srv -> sc: getTransactionReceipt(txHash)
sc --> srv: receipt status=1 + VersionRestored
srv -> db: Actualizar nueva version restaurada
db --> srv: OK
srv --> api: Pendiente de sincronizacion
api --> ui: Confirmacion registrada

sc -> listener: Evento VersionRestored(docId, versionNumber, timestamp)
listener -> db: Marcar version restaurada como SYNCED y operativa
listener -> ui: Refrescar historial de versiones
ui --> user: Version restaurada correctamente

@enduml

