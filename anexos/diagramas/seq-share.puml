@startuml
!include _sequence-style.puml
actor Usuario as owner
boundary "ShareModal.tsx" as ui
control "UserController (/api/users)" as usersApi
control "ShareController (/api/documents/:id/share + /api/shares)" as api
control "KeyManager" as crypto
control "ShareService" as srv
database "Base de datos" as db
participant "Wallet (EIP-6963 / WalletConnect)" as wallet
entity "DocumentRegistry" as sc
control "EventListenerService" as listener

owner -> ui: Busca destinatario por username/email y elige permiso (VIEWER/EDITOR)
ui -> usersApi: GET /api/users/search?q=username
usersApi -> db: Buscar usuario por username/email
db --> usersApi: Usuario con wallets asociadas
usersApi --> ui: 200 OK {id, username, wallets}

owner -> ui: Introduce contrasena para descifrar clave privada
ui -> crypto: decryptPrivateKey(encryptedPrivateKey, password)
crypto --> ui: privateKey en memoria
ui -> crypto: decryptWithPrivateKey(encryptedSymmetricKey, privateKey)
crypto --> ui: symmetricKey descifrada

ui -> api: POST /api/documents/:documentId/share/prepare {sharedWithUserId, role, walletId, decryptedSymmetricKey}
api -> srv: prepareShare(documentId, sharedWithUserId, role, ownerId, walletId, decryptedSymmetricKey)
srv -> db: Verificar documento, wallet del propietario y destinatario
db --> srv: blockchainId + recipientWalletAddress + recipientPublicKey
srv -> crypto: encryptWithPublicKey(symmetricKey, recipientPublicKey)
crypto --> srv: reEncryptedSymmetricKey
srv -> db: Guardar DocumentShareKey y evento SHARE_PREPARED
db --> srv: shareId, blockchainId, recipientWalletAddress
srv --> api: {shareId, blockchainId, sharedWithAddress}
api --> ui: 200 OK comparticion preparada

ui -> wallet: Firmar y enviar shareDocument(blockchainId, recipientAddress, role)
wallet -> sc: shareDocument(blockchainId, recipientAddress, role)
sc --> wallet: txHash
wallet --> ui: txHash

ui -> api: POST /api/shares/confirm {shareId, txHash}
api -> srv: confirmShare(shareId, txHash)
srv -> sc: getTransactionReceipt(txHash)
sc --> srv: receipt status=1 + DocumentShared
srv -> sc: getUserPermission(blockchainId, recipientAddress)
sc --> srv: Rol on-chain asignado
srv -> db: Registrar evento SHARE_CONFIRMED y notificacion al destinatario
db --> srv: OK
srv --> api: {share}
api --> ui: 200 OK confirmacion registrada

sc -> listener: Evento DocumentShared(docId, recipient, role, timestamp)
listener -> db: Registrar auditoria on-chain complementaria si no existe
listener -> ui: WebSocket / refrescar lista de accesos
ui --> owner: Destinatario anadido con permiso asignado

@enduml
