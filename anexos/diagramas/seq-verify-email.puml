@startuml
!include _sequence-style.puml
actor Usuario as user
boundary "Pagina de verificacion de email" as ui
control "Endpoints de email (/api/email)" as api
control "EmailController" as srv
database "Base de datos" as db

user -> ui: Abre el enlace recibido por correo
ui -> api: Verificar token
api -> srv: Comprobar vigencia y destinatario
srv -> db: Localizar token pendiente
db --> srv: Token y usuario asociados
srv -> db: Marcar verificacion como usada
srv -> db: Actualizar User.emailVerified = true
db --> srv: Estado actualizado
srv --> api: Verificacion completada
api --> ui: Correo validado
ui --> user: Acceso disponible sin avisos pendientes
@enduml

