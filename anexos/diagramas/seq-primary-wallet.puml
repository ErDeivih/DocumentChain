@startuml
!include _sequence-style.puml
actor Usuario as user
boundary "Ajustes / Wallets" as ui
control "Endpoints de wallets (/api/wallets)" as api
control "WalletService" as srv
database "PostgreSQL" as db

user -> ui: Marca una wallet como principal
ui -> api: Guardar wallet principal
api -> srv: Validar propiedad de la wallet
srv -> db: Desmarcar principal anterior y activar la nueva
db --> srv: Wallet principal actualizada
srv --> api: Cambio confirmado
api --> ui: Estado sincronizado
ui --> user: La wallet queda como opcion predeterminada
@enduml
