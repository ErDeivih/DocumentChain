@startuml

title Login
!include _sequence-style.puml
actor Usuario as user
boundary "Login.tsx" as ui
control "AuthController (/api/auth)" as api
control "AuthService" as srv
control "TokenService" as tokenSrv
database "Base de datos" as db

user -> ui: Introduce username/email y contrasena
ui -> ui: Valida formato de entrada
ui -> api: POST /auth/login {identifier, password}
api -> srv: validateCredentials(identifier, password)
srv -> db: Buscar usuario por username o email
db --> srv: usuario con hashedPassword y emailVerified
srv -> srv: Verificar contrasena con Argon2id
alt Credenciales invalidas
  srv --> api: Error 401 "Credenciales invalidas"
  api --> ui: Mostrar error de autenticacion
else Correo no verificado
  srv --> api: Error 401 "Correo no verificado"
  api --> ui: Mostrar bloqueo y boton de reenvio de verificacion
else Credenciales validas
  srv -> tokenSrv: generateAccessToken(userId) + generateRefreshToken(userId)
  tokenSrv --> srv: accessToken, refreshToken
  srv -> db: Crear sesion activa con refreshToken
  db --> srv: Sesion registrada
  srv --> api: {accessToken, refreshToken, user}
  api --> ui: 200 OK con tokens y perfil
  ui -> ui: Guardar tokens en almacenamiento local
  ui --> user: Redirige a /app/documents
end

@enduml

